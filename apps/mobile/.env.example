# ─── Firebase / Google Sign-In ──────────────────────────────────────
# Required for Google Sign-In on Android.
# Get this from Firebase Console → Project Settings → Web App OAuth Client ID
# (NOT the Android OAuth Client ID — that one is auto-resolved from google-services.json)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ─── EAS Project ID ────────────────────────────────────────────────
# Set after running `eas init` or `eas build:configure`
# This is also stored in app.config.ts → extra.eas.projectId
# EAS_PROJECT_ID=your-eas-project-id-here
