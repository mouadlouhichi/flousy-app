{
  "name": "flousy-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "mobile": "pnpm --filter @smartjib/mobile run start:dev-client",
    "mobile:go": "pnpm --filter @smartjib/mobile run start",
    "mobile:android": "pnpm --filter @smartjib/mobile run android",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.3",
    "next": "^15.5.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react@>=19": "19.1.10",
      "@types/react-dom@>=19": "19.1.7"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
