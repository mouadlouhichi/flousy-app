# Household invitation email (server-side only; set in Vercel, never expose to browser)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SmartJib <onboarding@resend.dev>
APP_URL=

# Canonical origin for rel="canonical", the sitemap, robots.txt and social share
# URLs. Set it per environment (a preview must not advertise the production
# origin). Unset falls back to https://flousy.app.
NEXT_PUBLIC_SITE_URL=

# Base URL used for the household-invitation accept link. Falls back to
# NEXT_PUBLIC_SITE_URL.
APP_URL=
