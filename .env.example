# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Firebase Analytics stays unloaded until the user grants consent.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional bridge to a separately installed provider script: plausible or ga.
# The repository does not inject either script; unset keeps that bridge disabled.
NEXT_PUBLIC_ANALYTICS=

# Transactional email (server-side only; set in Vercel, never expose to browser).
# Unset RESEND_API_KEY => invitation/contact APIs report that delivery is not
# configured, and auth emails (password reset / email verification) fall back
# to Firebase's built-in noreply@<project>.firebaseapp.com mailer.
# Vercel scopes variables per environment, so configure Production and Preview separately.
RESEND_API_KEY=
# onboarding@resend.dev is a development sandbox sender and is refused for
# production household invitations and contact delivery. Use a sender on your
# SPF/DKIM-verified domain.
RESEND_FROM_EMAIL=SmartJib <onboarding@resend.dev>
# Optional dedicated sender for auth/security mail (password reset, email
# verification) sent by /api/auth/email with the branded template; falls back
# to RESEND_FROM_EMAIL when unset. Requires FIREBASE_SERVICE_ACCOUNT_JSON so
# the server can mint the action links (see "Pro features" below); the emails
# point at the branded /auth/action handler page.
RESEND_AUTH_FROM_EMAIL=SmartJib Security <no-reply@smartjib.app>
# Inbox that receives /api/contact form submissions; the API never accepts a
# recipient from a request. Unset => /api/contact answers 503 and the form
# shows the direct support address instead of faking success.
CONTACT_TO_EMAIL=hello@smartjib.app

# Canonical origin for rel="canonical", sitemap, robots and social-share URLs.
# Set it per environment; unset falls back to https://smartjib.app.
NEXT_PUBLIC_SITE_URL=
# Base URL for household invitation links. Falls back to NEXT_PUBLIC_SITE_URL,
# then the platform-provided Vercel deployment URL.
APP_URL=

# --- Optional hardening & observability (all inert when unset) ---------------

# Arcjet (https://arcjet.com): shield + bot detection on the public API routes
# (/api/contact, /api/household-invitations). Unset => requests pass straight
# to each route's own auth + rate limiting. Server-side only.
ARCJET_KEY=
# Cosmetic INCI enrichment key (https://inciapi.com): OPTIONAL. When set:
# 1. the barcode proxy (/api/barcode/lookup) fills INCI lists that Open Beauty
#    Facts is missing for cosmetics, and can resolve codes no OFF-family
#    mirror knows;
# 2. /api/inci/lookup backs the scan panel's missing-INCI fallback for a
#    resolved cosmetic record (code-like beauty names included), so a
#    vendor-supplied list can still be scored locally;
# 3. /api/inci/analyze asks the provider about names the LOCAL identity corpus
#    does not recognize and returns any observation as attributed external
#    evidence. Provider output never changes local identity coverage, evidence
#    coverage, tier, score, or regulatory authority.
# Unset => no enrichment, zero vendor calls. Server-side only; never exposed
# to the client.
INCI_API_KEY=
# Deployment-specific HMAC secret for durable, privacy-minimized aggregates of
# unrecognized ingredient tokens. Only token hash + count + bounded assessment
# context are written; no raw token, label, barcode, product/account ID or IP.
# Unset => bounded process-memory aggregation only (no durable token digest).
UNKNOWN_INGREDIENT_HASH_KEY=
# Deep-search knowledge slot for FOOD-label analysis (https://api.deepseek.com
# or any OpenAI-compatible /chat/completions endpoint): OPTIONAL. When both
# KNOWLEDGE_API_URL and KNOWLEDGE_API_KEY are set, /api/food/analyze asks the
# provider for short neutral explanations of ingredient names the LOCAL
# knowledge base does not recognize. Answers are informational only
# (attributed "external source", never modifying local allergen/additive
# verdicts), bounded (≤ 40 names, 4 s timeout) and fail-open. Unset =>
# purely local analysis, zero calls. Server-side only.
KNOWLEDGE_API_URL=
KNOWLEDGE_API_KEY=
# Optional model override; defaults to gpt-4o-mini. For DeepSeek use
# deepseek-chat and KNOWLEDGE_API_URL=https://api.deepseek.com
KNOWLEDGE_API_MODEL=
# Upstash Redis (https://upstash.com): makes API rate limits durable across
# serverless instances and cold starts. Unset => per-instance in-memory
# limits (the historical behaviour). Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry: server-side forwarding of the consent-gated, sanitized reports that
# already arrive at /api/client-errors. No browser SDK is loaded and no CSP
# change is needed. Unset => reports stay in the server log only.
SENTRY_DSN=

# Better Stack (https://betterstack.com) logs: same reports forwarded to the
# Logtail ingest API. BETTERSTACK_URL is your source's ingest host (defaults
# to https://in.logs.betterstack.com); BETTERSTACK_API_KEY is the source token.
# Uptime monitors are configured in the Better Stack dashboard, not in code
# (see PRODUCTION_CHECKLIST §8).
BETTERSTACK_API_KEY=
BETTERSTACK_URL=

# --- Pro features (PWA) ---------------------------------------------------
# Web Push bill reminders. Generate once: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Firebase Admin service-account JSON (raw or base64) used by the reminder
# dispatcher to read profiles / push subscriptions server-side, and by
# /api/auth/email to mint branded password-reset / email-verification links.
# Generate: Firebase console → Project settings → Service accounts → "Generate
# new private key" (downloads a .json). Keep it server-side only — this key is
# full admin access to the project.
# Paste it as base64 (survives env-var UIs losslessly):
#   base64 -w0 service-account.json        # Linux
#   base64 -i service-account.json         # macOS
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret the scheduler sends as `Authorization: Bearer <secret>` to
# /api/reminders/dispatch (Vercel Cron sets it automatically from CRON_SECRET).
CRON_SECRET=
# Google OAuth *Web application* client id for Google Drive backups
# (appDataFolder scope). Leave empty to hide the Drive buttons.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
