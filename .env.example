# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# Household invitation email (server-side only; set in Vercel, never expose to browser).
# Unset RESEND_API_KEY => /api/household-invitations answers 503 email_not_configured
# and the UI falls back to sharing the invite code. Vercel scopes env vars per
# environment: adding these to Production only leaves Preview/Development 503.
RESEND_API_KEY=
# onboarding@resend.dev is Resend's sandbox sender: it delivers only to the
# address verified on the Resend account, and production deployments refuse it.
RESEND_FROM_EMAIL=SmartJib <onboarding@resend.dev>
APP_URL=

# Canonical origin for rel="canonical", the sitemap, robots.txt and social share
# URLs. Set it per environment (a preview must not advertise the production
# origin). Unset falls back to https://flousy.app.
NEXT_PUBLIC_SITE_URL=

# Base URL used for the household-invitation accept link. Falls back to
# NEXT_PUBLIC_SITE_URL.
APP_URL=
