{
  "$comment": "Machine-readable Firestore data model for SmartJib. Kept in lockstep with src/lib/store.ts, src/lib/db.ts and firestore.rules by tests/blueprint.test.ts — run `npm run test` after changing any of them.",
  "description": "SmartJib stores private finance records under /users/{uid}, shared workspaces under /households/{householdId}, and verified-email invitations at /householdInvites/{inviteId}. Monthly and savings documents are revisioned and paired with immutable ledger entries.",
  "definitions": {
    "IncomeSource": {
      "title": "IncomeSource",
      "description": "A single income stream contributing to the month's total budget.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "partial",
            "paid",
            "skipped"
          ]
        },
        "receivedAmount": {
          "type": "number"
        },
        "receivedAt": {
          "type": "string"
        },
        "recurring": {
          "type": "boolean"
        },
        "templateId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "payDay": {
          "type": "number",
          "minimum": 1,
          "maximum": 31,
          "description": "Day of the month (1-31) this salary/income is paid; used as the source's monthly start date"
        }
      },
      "required": [
        "id",
        "name",
        "amount"
      ]
    },
    "VariableExpense": {
      "title": "VariableExpense",
      "description": "A day-to-day expense logged against a category and a money place.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "place": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "note": {
          "type": "string",
          "maxLength": 250
        },
        "person": {
          "type": "string",
          "description": "Household member the expense belongs to"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receiptUrl": {
          "type": "string"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "invoice",
            "course",
            "csv",
            "manual"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "importFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "date",
        "place"
      ]
    },
    "FixedExpense": {
      "title": "FixedExpense",
      "description": "A recurring bill. `base` stores the planned amount so overspend can be measured.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "description": "Due day such as \"1st\" or \"15th\", or a YYYY-MM-DD date"
        },
        "place": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "person": {
          "type": "string",
          "description": "Household member the bill belongs to"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        },
        "recurring": {
          "type": "boolean"
        },
        "templateId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "partial",
            "paid",
            "skipped"
          ]
        },
        "paidAmount": {
          "type": "number"
        },
        "paidAt": {
          "type": "string"
        },
        "receiptUrl": {
          "type": "string"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "invoice",
            "csv",
            "manual"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "importFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "place"
      ]
    },
    "FixedCategoryItem": {
      "title": "FixedCategoryItem",
      "description": "Custom fixed-bill category stored on the user profile.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "color",
        "icon"
      ]
    },
    "SavingGoal": {
      "title": "SavingGoal",
      "description": "A global saving goal. Months move money into or out of it; it never resets at rollover.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "current": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "source": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "active": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "deposited": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Money actually deposited into this goal (fund flow or checkbox transfer). Excludes bookkeeping \"already saved\" balances recorded without the transfer checkbox; the home-screen savings plan sums only this."
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "current",
        "source",
        "active"
      ]
    },
    "DebtItem": {
      "title": "DebtItem",
      "description": "Money owed to someone ('debt') or owed to the user ('credit').",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Person or entity on the other side"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "enum": [
            "debt",
            "credit"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "settled"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueDate": {
          "type": "string"
        },
        "payments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebtPayment"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 250
        },
        "carriedFromId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "status",
        "date"
      ]
    },
    "SavingsActivityEntry": {
      "title": "SavingsActivityEntry",
      "description": "One savings deposit or withdrawal logged on the month for Recent Activity.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "goalId": {
          "type": "string"
        },
        "goalName": {
          "type": "string",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": [
            "deposit",
            "withdraw"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "date": {
          "type": "string",
          "description": "ISO timestamp of the transaction"
        }
      },
      "required": [
        "id",
        "goalId",
        "goalName",
        "type",
        "amount",
        "date"
      ]
    },
    "CustomRatios": {
      "title": "CustomRatios",
      "description": "User-defined allocation for the 'custom' strategy. Fractions of income that always sum to 1.",
      "type": "object",
      "properties": {
        "needs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wants": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "savings": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "needs",
        "wants",
        "savings"
      ]
    },
    "MoneyPlaceConfig": {
      "title": "MoneyPlaceConfig",
      "description": "A tracked cash location the user can rename, add or remove from Profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "icon"
      ]
    },
    "SessionItem": {
      "title": "SessionItem",
      "description": "One line of a course session; name/category are snapshots of the product at scan time.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Stable line id: the barcode when present, else a generated row id"
        },
        "barcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$|^[0-9]{13}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string"
        },
        "qty": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "lineTotal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "round2(unitPrice * qty) — stored, never re-derived"
        }
      },
      "required": [
        "key",
        "name",
        "qty",
        "unitPrice",
        "lineTotal"
      ]
    },
    "DebtPayment": {
      "title": "DebtPayment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string"
        },
        "place": {},
        "note": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "amount",
        "date",
        "place"
      ]
    },
    "AccountTransfer": {
      "title": "AccountTransfer",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {},
        "to": {},
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "amount",
        "date"
      ]
    },
    "BalanceAdjustment": {
      "title": "BalanceAdjustment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "place": {},
        "previousBalance": {
          "type": "number"
        },
        "newBalance": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "enum": [
            "reconciliation",
            "opening-balance",
            "income"
          ]
        },
        "note": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "place",
        "previousBalance",
        "newBalance",
        "delta",
        "reason",
        "date"
      ]
    },
    "PushSubscriptionRecord": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "properties": {
            "p256dh": {
              "type": "string"
            },
            "auth": {
              "type": "string"
            }
          }
        },
        "label": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "title": "PushSubscriptionRecord"
    }
  },
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account configuration and plan details.",
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "enum": [
            "free",
            "pro"
          ],
          "description": "Coarse plan projection. Effective Pro access also requires an unexpired entitlement. Browser clients may perform exactly one rules-validated free -> pro launch-trial transition lasting 90 days; future Stripe/CMI webhooks update the provider-neutral entitlement fields through Firebase Admin SDK."
        },
        "entitlementSource": {
          "type": "string",
          "enum": [
            "launch_trial",
            "stripe",
            "cmi",
            "admin"
          ]
        },
        "entitlementStatus": {
          "type": "string",
          "enum": [
            "trialing",
            "active",
            "grace_period",
            "past_due",
            "canceled",
            "expired"
          ]
        },
        "entitlementStartedAtMs": {
          "type": "number"
        },
        "entitlementEndsAtMs": {
          "type": "number"
        },
        "proTrialClaimedAt": {
          "type": "string"
        },
        "planBillingCycle": {
          "type": "string",
          "enum": [
            "monthly",
            "annual"
          ],
          "description": "Billing cycle selected at checkout, written to Firebase alongside `plan`"
        },
        "planNextBillingDate": {
          "type": "string",
          "description": "Next billing date (YYYY-MM-DD) written to Firebase when `plan` upgrades"
        },
        "currency": {
          "type": "string",
          "maxLength": 10
        },
        "onboardingComplete": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 160000,
          "description": "Persisted profile image: a small JPEG data URL or HTTPS identity-provider photo."
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "ar"
          ]
        },
        "householdMembers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Legacy local profile labels retained for backward compatibility; not authoritative membership."
        },
        "activeHouseholdId": {
          "type": "string"
        },
        "activeWorkspace": {
          "type": "string",
          "enum": [
            "personal",
            "household"
          ]
        },
        "householdIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultCategoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: default per-category budgets applied to new months"
        },
        "defaultCategoryEnvelopes": {
          "type": "object"
        },
        "enableRollover": {
          "type": "boolean",
          "description": "Pro feature: carry unused category budget into the next month"
        },
        "fixedCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedCategoryItem"
          },
          "description": "User-defined fixed-bill categories shown in the Add Fixed Charge modal"
        },
        "monthStartDate": {
          "type": "number",
          "minimum": 1,
          "maximum": 31,
          "description": "Payday of the Personal workspace: the day of the month its budget month starts; mirrors the per-source salary start date"
        },
        "householdMonthStartDate": {
          "type": "number",
          "minimum": 1,
          "maximum": 31,
          "description": "Payday of the Household workspace, stored per workspace so switching workspace does not change the other one. Falls back to monthStartDate while unset."
        },
        "moneyPlaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MoneyPlaceConfig"
          },
          "description": "Cash locations (Bank, Home, Wallet, plus any the user added)"
        },
        "reminderPrefs": {
          "type": "object",
          "description": "Pro: reminder channel preferences (bills / goals / email digest).",
          "properties": {
            "billsEnabled": {
              "type": "boolean"
            },
            "billLeadDays": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "goalsEnabled": {
              "type": "boolean"
            },
            "emailDigest": {
              "type": "boolean"
            },
            "hour": {
              "type": "number"
            }
          }
        },
        "pushSubscriptions": {
          "type": "array",
          "description": "Pro: Web Push subscriptions of this account's devices (max 10).",
          "items": {
            "$ref": "#/definitions/PushSubscriptionRecord"
          }
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone used by the reminder dispatcher."
        },
        "email": {
          "type": "string",
          "description": "Sign-in email, copied only when the email digest is enabled."
        },
        "goalTargetDates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Pro: savings goal target dates (goalId → YYYY-MM-DD)."
        },
        "debtPayoffBudget": {
          "type": "number",
          "description": "Pro: monthly amount committed to the debt payoff plan."
        },
        "debtPayoffMethod": {
          "type": "string",
          "enum": [
            "snowball",
            "avalanche"
          ]
        }
      },
      "required": [
        "plan",
        "currency",
        "onboardingComplete"
      ]
    },
    "MonthBudget": {
      "title": "MonthBudget",
      "description": "Monthly budget state including money places and expenses.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number"
        },
        "revision": {
          "type": "number"
        },
        "lastMutationId": {
          "type": "string"
        },
        "periodKey": {
          "type": "string"
        },
        "periodStartDay": {
          "type": "number"
        },
        "periodStartDate": {
          "type": "string"
        },
        "periodEndDate": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "periodStatus": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ],
          "description": "Closed periods are read-only until an explicit owner reopen."
        },
        "closedAt": {
          "type": "string"
        },
        "closedByUserId": {
          "type": "string"
        },
        "totalBudget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Total income for the month"
        },
        "incomeSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IncomeSource"
          },
          "description": "Defaults to a single 'Primary Income' source equal to totalBudget"
        },
        "bankPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "homePart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "walletPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "strategyId": {
          "type": "string",
          "enum": [
            "50-30-20",
            "70-20-10",
            "80-20",
            "zero-based",
            "envelope",
            "pay-first",
            "custom"
          ]
        },
        "customRatios": {
          "$ref": "#/definitions/CustomRatios",
          "description": "Definable Needs/Wants/Savings split, applied when strategyId is 'custom'"
        },
        "categoryEnvelopes": {
          "type": "object"
        },
        "monthlySavingsTarget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "variableExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VariableExpense"
          },
          "maxItems": 2000
        },
        "fixedExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedExpense"
          },
          "maxItems": 500
        },
        "variableCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for variable spending"
        },
        "fixedCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for fixed bills"
        },
        "categoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: planned maximum per category for the month"
        },
        "rolloverFromPrevious": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: unused category budgets rolled over from the previous month"
        },
        "activeCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categoryColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to hex colour, e.g. #f97316"
        },
        "categoryIcons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to Material Symbols icon name"
        },
        "debts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebtItem"
          }
        },
        "transfers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AccountTransfer"
          }
        },
        "balanceAdjustments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BalanceAdjustment"
          }
        },
        "savingsActivity": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/SavingsActivityEntry"
          },
          "description": "Deposit / withdrawal log feeding the home-screen Recent Activity list"
        },
        "placeBalances": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "description": "Balances for user-defined money sources (beyond bank / home / wallet)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the last write"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "totalBudget",
        "bankPart",
        "homePart",
        "walletPart",
        "strategyId",
        "monthlySavingsTarget",
        "variableExpenses",
        "fixedExpenses",
        "variableCategoryBases",
        "fixedCategoryBases",
        "activeCategories",
        "categoryColors",
        "categoryIcons",
        "updatedAt"
      ]
    },
    "SavingsData": {
      "title": "SavingsData",
      "description": "Revisioned workspace savings goals wrapper.",
      "type": "object",
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SavingGoal"
          },
          "maxItems": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "lastMutationId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "goals"
      ]
    },
    "Household": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "ownerId": {
          "type": "string"
        },
        "planOwnerId": {
          "type": "string"
        },
        "entitlementOwnerId": {
          "type": "string"
        },
        "entitlementSource": {
          "type": "string",
          "enum": [
            "launch_trial",
            "stripe",
            "cmi",
            "admin"
          ]
        },
        "entitlementStatus": {
          "type": "string",
          "enum": [
            "trialing",
            "active",
            "grace_period",
            "past_due",
            "canceled",
            "expired"
          ]
        },
        "entitlementEndsAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "onboardingComplete": {
          "type": "boolean"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8
        },
        "monthStartDate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "moneyPlaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/definitions/MoneyPlaceConfig"
          }
        },
        "activeCategories": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "categoryColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "categoryIcons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fixedCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedCategoryItem"
          }
        },
        "defaultCategoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "enableRollover": {
          "type": "boolean"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "ownerId",
        "planOwnerId",
        "entitlementOwnerId",
        "currency",
        "moneyPlaces",
        "activeCategories",
        "createdAt",
        "updatedAt"
      ],
      "description": "Authoritative shared-workspace configuration and immutable projection of the owner entitlement."
    },
    "HouseholdMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "editor",
            "contributor",
            "viewer",
            "custom",
            "profile"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "invited",
            "inactive"
          ]
        },
        "avatarColor": {
          "type": "string"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "view",
              "editOwn",
              "editAll"
            ]
          },
          "description": "Legacy-only custom permission map; authorization maps stored roles to rules-enforceable document access."
        },
        "inviteId": {
          "type": "string"
        },
        "invitedAt": {
          "type": "string"
        },
        "joinedAt": {
          "type": "string"
        },
        "retiredAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName",
        "role",
        "status",
        "avatarColor"
      ],
      "description": "UID-indexed active membership or pending/profile row. Firestore Rules enforce role-level document access."
    },
    "HouseholdInvite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "householdId": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": [
            "editor",
            "contributor",
            "viewer",
            "custom"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "view",
              "editOwn",
              "editAll"
            ]
          },
          "description": "Legacy-only custom permission map; authorization maps stored roles to rules-enforceable document access."
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "revoked"
          ]
        },
        "acceptedByUserId": {
          "type": "string"
        },
        "acceptedEmail": {
          "type": "string",
          "format": "email"
        },
        "acceptedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "householdId",
        "memberId",
        "email",
        "role",
        "createdBy",
        "createdAt",
        "expiresAt",
        "expiresAtMs",
        "status"
      ],
      "description": "Verified-email invitation with a numeric Rules-enforced expiry and auditable acceptance projection."
    },
    "HouseholdInvoice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "category": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "submitterId": {
          "type": "string"
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "receiptUrl": {
          "type": "string",
          "maxLength": 120000
        },
        "note": {
          "type": "string",
          "maxLength": 250
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "approved",
            "rejected"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string"
        },
        "reviewedByUserId": {
          "type": "string"
        },
        "postedExpenseId": {
          "type": "string"
        },
        "postedMonthKey": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "category",
        "date",
        "payerMemberId",
        "submitterId",
        "place",
        "status",
        "createdAt"
      ],
      "description": "Contributor-owned submission. Approval atomically posts a deterministic expense and immutable ledger entry."
    },
    "Product": {
      "title": "Product",
      "description": "Course catalog entry keyed by normalized barcode; the user's self-learning product database.",
      "type": "object",
      "properties": {
        "barcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$|^[0-9]{13}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "brand": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "imageUrl": {
          "type": "string"
        },
        "lastPrice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "priceUpdatedAt": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "off",
            "session"
          ],
          "description": "Where the metadata came from"
        },
        "origin": {
          "type": "string",
          "description": "'MA' for Moroccan products (GS1 prefix 611)"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "barcode",
        "name",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseSession": {
      "title": "CourseSession",
      "description": "A course (shopping trip) captured by scanning barcodes. A completed session IS its bill.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "completed"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The trip date (YYYY-MM-DD)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "place": {
          "type": "string",
          "enum": [
            "bank",
            "home",
            "wallet"
          ],
          "description": "Money place the course was paid from"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SessionItem"
          },
          "maxItems": 500
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Denormalized sum of lineTotals"
        },
        "loggedExpenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Id of the variable expense the total was logged as (idempotency link)"
        },
        "loggedMonthKey": {
          "type": "string"
        },
        "loggedWorkspace": {
          "type": "string",
          "enum": [
            "personal",
            "household"
          ]
        },
        "loggedWorkspaceId": {
          "type": "string"
        },
        "loggedMutationId": {
          "type": "string"
        },
        "loggedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "startedAt",
        "date",
        "currency",
        "place",
        "items",
        "total"
      ]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable idempotency and audit record for a finance mutation.",
      "type": "object",
      "properties": {
        "mutationId": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        },
        "workspace": {
          "type": "string",
          "enum": [
            "personal",
            "household"
          ]
        },
        "workspaceId": {
          "type": "string"
        },
        "monthKey": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bootstrap",
            "savings-bootstrap",
            "savings",
            "month",
            "month-and-savings",
            "month-close",
            "month-reopen",
            "course-post",
            "invoice-approval"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0
        },
        "nextRevision": {
          "type": "integer",
          "minimum": 1
        },
        "balanceDelta": {
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "committedAt": {
          "type": "string"
        }
      },
      "required": [
        "mutationId",
        "actorId",
        "workspace",
        "workspaceId",
        "monthKey",
        "kind",
        "baseRevision",
        "nextRevision",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{uid}/months/{monthKey}": {
      "schema": "MonthBudget",
      "description": "Revisioned monthly budget records",
      "idPattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "/users/{uid}/data/savings": {
      "schema": "SavingsData",
      "description": "Revisioned global savings goals document"
    },
    "/users/{uid}/ledger/{mutationId}": {
      "schema": "LedgerEntry",
      "description": "Immutable personal finance mutation ledger"
    },
    "/users/{uid}/products/{barcode}": {
      "schema": "Product",
      "description": "Course catalog by normalized barcode",
      "idPattern": "^[0-9]{8}$|^[0-9]{13}$"
    },
    "/users/{uid}/sessions/{sessionId}": {
      "schema": "CourseSession",
      "description": "Shopping trip and posting state"
    },
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Shared household workspace and authoritative configuration"
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": "HouseholdMember",
      "description": "Household membership and enforceable role"
    },
    "/householdInvites/{inviteId}": {
      "schema": "HouseholdInvite",
      "description": "Verified-email, expiry-bound invitation"
    },
    "/households/{householdId}/months/{monthKey}": {
      "schema": "MonthBudget",
      "description": "Revisioned shared monthly budget",
      "idPattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "/households/{householdId}/data/savings": {
      "schema": "SavingsData",
      "description": "Revisioned shared savings goals"
    },
    "/households/{householdId}/ledger/{mutationId}": {
      "schema": "LedgerEntry",
      "description": "Immutable household finance mutation ledger"
    },
    "/households/{householdId}/invoices/{invoiceId}": {
      "schema": "HouseholdInvoice",
      "description": "Contributor submissions with atomic approval posting"
    }
  }
}
