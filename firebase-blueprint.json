{
  "$comment": "Machine-readable Firestore data model for SmartJib. Kept in lockstep with src/lib/store.ts, src/lib/db.ts and firestore.rules by tests/blueprint.test.ts — run `npm run test` after changing any of them.",
  "description": "Every persisted document lives under /users/{uid}. Money is tracked in three places (bank, home, wallet) and budgeted through one strategy per month. Saving goals are global, not per-month.",
  "definitions": {
    "IncomeSource": {
      "title": "IncomeSource",
      "description": "A single income stream contributing to the month's total budget.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "category": {
          "type": "string"
        },
        "payDay": {
          "type": "number",
          "minimum": 1,
          "maximum": 31,
          "description": "Day of the month (1-31) this salary/income is paid; used as the source's monthly start date"
        }
      },
      "required": [
        "id",
        "name",
        "amount"
      ]
    },
    "VariableExpense": {
      "title": "VariableExpense",
      "description": "A day-to-day expense logged against a category and a money place.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "place": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "note": {
          "type": "string",
          "maxLength": 250
        },
        "person": {
          "type": "string",
          "description": "Household member the expense belongs to"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receiptUrl": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "date",
        "place"
      ]
    },
    "FixedExpense": {
      "title": "FixedExpense",
      "description": "A recurring bill. `base` stores the planned amount so overspend can be measured.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "description": "Due day such as \"1st\" or \"15th\", or a YYYY-MM-DD date"
        },
        "place": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "person": {
          "type": "string",
          "description": "Household member the bill belongs to"
        },
        "recurring": {
          "type": "boolean"
        },
        "receiptUrl": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "place"
      ]
    },
    "FixedCategoryItem": {
      "title": "FixedCategoryItem",
      "description": "Custom fixed-bill category stored on the user profile.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "color",
        "icon"
      ]
    },
    "SavingGoal": {
      "title": "SavingGoal",
      "description": "A global saving goal. Months move money into or out of it; it never resets at rollover.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "current": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "deposited": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Money actually deposited into this goal (fund flow or checkbox transfer). Excludes bookkeeping \"already saved\" balances recorded without the transfer checkbox; the home-screen savings plan sums only this."
        },
        "source": {
          "type": "string",
          "description": "Money source id (bank, home, wallet, or a user-defined location)"
        },
        "active": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "current",
        "source",
        "active"
      ]
    },
    "DebtItem": {
      "title": "DebtItem",
      "description": "Money owed to someone ('debt') or owed to the user ('credit').",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Person or entity on the other side"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "enum": [
            "debt",
            "credit"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "settled"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 250
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "status",
        "date"
      ]
    },
    "SavingsActivityEntry": {
      "title": "SavingsActivityEntry",
      "description": "One savings deposit or withdrawal logged on the month for Recent Activity.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "goalId": {
          "type": "string"
        },
        "goalName": {
          "type": "string",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": [
            "deposit",
            "withdraw"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "date": {
          "type": "string",
          "description": "ISO timestamp of the transaction"
        }
      },
      "required": [
        "id",
        "goalId",
        "goalName",
        "type",
        "amount",
        "date"
      ]
    },
    "CustomRatios": {
      "title": "CustomRatios",
      "description": "User-defined allocation for the 'custom' strategy. Fractions of income that always sum to 1.",
      "type": "object",
      "properties": {
        "needs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wants": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "savings": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "needs",
        "wants",
        "savings"
      ]
    },
    "MoneyPlaceConfig": {
      "title": "MoneyPlaceConfig",
      "description": "A tracked cash location the user can rename, add or remove from Profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "icon"
      ]
    },
    "SessionItem": {
      "title": "SessionItem",
      "description": "One line of a course session; name/category are snapshots of the product at scan time.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Stable line id: the barcode when present, else a generated row id"
        },
        "barcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$|^[0-9]{13}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string"
        },
        "qty": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "lineTotal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "round2(unitPrice * qty) — stored, never re-derived"
        }
      },
      "required": [
        "key",
        "name",
        "qty",
        "unitPrice",
        "lineTotal"
      ]
    }
  },
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account configuration and plan details.",
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "enum": [
            "free",
            "pro"
          ],
          "description": "Single source of truth for Pro access, stored on the Firebase user profile. New profiles always start as 'free'; while payments are mocked the signed-in owner may flip it to 'pro' after checkout (validated by firestore.rules)."
        },
        "planBillingCycle": {
          "type": "string",
          "enum": [
            "monthly",
            "annual"
          ],
          "description": "Billing cycle selected at checkout, written to Firebase alongside `plan`"
        },
        "planNextBillingDate": {
          "type": "string",
          "description": "Next billing date (YYYY-MM-DD) written to Firebase when `plan` upgrades"
        },
        "currency": {
          "type": "string",
          "maxLength": 10
        },
        "onboardingComplete": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 160000,
          "description": "Persisted profile image: a small JPEG data URL or HTTPS identity-provider photo."
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "ar"
          ]
        },
        "householdMembers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultCategoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: default per-category budgets applied to new months"
        },
        "enableRollover": {
          "type": "boolean",
          "description": "Pro feature: carry unused category budget into the next month"
        },
        "fixedCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedCategoryItem"
          },
          "description": "User-defined fixed-bill categories shown in the Add Fixed Charge modal"
        },
        "activeHouseholdId": {
          "type": "string"
        },
        "householdIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeWorkspace": {
          "type": "string",
          "enum": [
            "personal",
            "household"
          ]
        },
        "monthStartDate": {
          "type": "number",
          "minimum": 1,
          "maximum": 31,
          "description": "Global preference for the day of the month a budget month starts; mirrors the per-source salary start date"
        },
        "moneyPlaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MoneyPlaceConfig"
          },
          "description": "Cash locations (Bank, Home, Wallet, plus any the user added)"
        }
      },
      "required": [
        "plan",
        "currency",
        "onboardingComplete"
      ]
    },
    "MonthBudget": {
      "title": "MonthBudget",
      "description": "Monthly budget state including money places and expenses.",
      "type": "object",
      "properties": {
        "totalBudget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Total income for the month"
        },
        "incomeSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IncomeSource"
          },
          "description": "Defaults to a single 'Primary Income' source equal to totalBudget"
        },
        "bankPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "homePart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "walletPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "strategyId": {
          "type": "string",
          "enum": [
            "50-30-20",
            "70-20-10",
            "80-20",
            "zero-based",
            "envelope",
            "pay-first",
            "custom"
          ]
        },
        "customRatios": {
          "$ref": "#/definitions/CustomRatios",
          "description": "Definable Needs/Wants/Savings split, applied when strategyId is 'custom'"
        },
        "monthlySavingsTarget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "variableExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VariableExpense"
          },
          "maxItems": 2000
        },
        "fixedExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedExpense"
          },
          "maxItems": 500
        },
        "categoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: planned maximum per category for the month"
        },
        "rolloverFromPrevious": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: unused category budgets rolled over from the previous month"
        },
        "variableCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for variable spending"
        },
        "fixedCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for fixed bills"
        },
        "activeCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categoryColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to hex colour, e.g. #f97316"
        },
        "categoryIcons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to Material Symbols icon name"
        },
        "debts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebtItem"
          }
        },
        "savingsActivity": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/SavingsActivityEntry"
          },
          "description": "Deposit / withdrawal log feeding the home-screen Recent Activity list"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the last write"
        },
        "updatedByUserId": {
          "type": "string"
        },
        "placeBalances": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "description": "Balances for user-defined money sources (beyond bank / home / wallet)"
        }
      },
      "required": [
        "totalBudget",
        "bankPart",
        "homePart",
        "walletPart",
        "strategyId",
        "monthlySavingsTarget",
        "variableExpenses",
        "fixedExpenses",
        "variableCategoryBases",
        "fixedCategoryBases",
        "activeCategories",
        "categoryColors",
        "categoryIcons",
        "updatedAt"
      ]
    },
    "SavingsData": {
      "title": "SavingsData",
      "description": "Global savings goals list for the user.",
      "type": "object",
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SavingGoal"
          },
          "maxItems": 200
        }
      },
      "required": [
        "goals"
      ]
    },
    "Household": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "planOwnerId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "ownerId",
        "planOwnerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "HouseholdMember": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "avatarColor": {
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "role",
        "status",
        "avatarColor"
      ]
    },
    "HouseholdInvite": {
      "type": "object",
      "properties": {
        "householdId": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "householdId",
        "memberId",
        "email",
        "role",
        "createdBy",
        "createdAt",
        "expiresAt",
        "status"
      ]
    },
    "HouseholdInvoice": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "submitterId": {
          "type": "string"
        },
        "receiptUrl": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "approved",
            "rejected"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "amount",
        "category",
        "date",
        "payerMemberId",
        "submitterId",
        "status",
        "createdAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Course catalog entry keyed by normalized barcode; the user's self-learning product database.",
      "type": "object",
      "properties": {
        "barcode": {
          "type": "string",
          "pattern": "^[0-9]{8}$|^[0-9]{13}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "brand": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "imageUrl": {
          "type": "string"
        },
        "lastPrice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "priceUpdatedAt": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "off",
            "session"
          ],
          "description": "Where the metadata came from"
        },
        "origin": {
          "type": "string",
          "description": "'MA' for Moroccan products (GS1 prefix 611)"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "barcode",
        "name",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseSession": {
      "title": "CourseSession",
      "description": "A course (shopping trip) captured by scanning barcodes. A completed session IS its bill.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "completed"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The trip date (YYYY-MM-DD)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "place": {
          "type": "string",
          "enum": [
            "bank",
            "home",
            "wallet"
          ],
          "description": "Money place the course was paid from"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SessionItem"
          },
          "maxItems": 500
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Denormalized sum of lineTotals"
        },
        "loggedExpenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Id of the variable expense the total was logged as (idempotency link)"
        }
      },
      "required": [
        "id",
        "status",
        "startedAt",
        "date",
        "currency",
        "place",
        "items",
        "total"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{uid}/months/{monthKey}": {
      "schema": "MonthBudget",
      "description": "Monthly budget records",
      "idPattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "/users/{uid}/data/savings": {
      "schema": "SavingsData",
      "description": "Global savings goals document"
