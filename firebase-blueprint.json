{
  "$comment": "Machine-readable Firestore data model for SmartJib. Kept in lockstep with src/lib/store.ts, src/lib/db.ts and firestore.rules by tests/blueprint.test.ts \u2014 run `npm run test` after changing any of them.",
  "description": "Every persisted document lives under /users/{uid}. Money is tracked in three places (bank, home, wallet) and budgeted through one strategy per month. Saving goals are global, not per-month.",
  "definitions": {
    "IncomeSource": {
      "title": "IncomeSource",
      "description": "A single income stream contributing to the month's total budget.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount"
      ]
    },
    "VariableExpense": {
      "title": "VariableExpense",
      "description": "A day-to-day expense logged against a category and a money place.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "place": {
          "type": "string",
          "enum": [
            "bank",
            "home",
            "wallet"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 250
        },
        "person": {
          "type": "string",
          "description": "Household member the expense belongs to"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receiptUrl": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "date",
        "place"
      ]
    },
    "FixedExpense": {
      "title": "FixedExpense",
      "description": "A recurring bill. `base` stores the planned amount so overspend can be measured.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "description": "Category name, must exist in MonthBudget.activeCategories"
        },
        "date": {
          "type": "string",
          "description": "Due day such as \"1st\" or \"15th\", or a YYYY-MM-DD date"
        },
        "place": {
          "type": "string",
          "enum": [
            "bank",
            "home",
            "wallet"
          ]
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "person": {
          "type": "string",
          "description": "Household member the bill belongs to"
        },
        "recurring": {
          "type": "boolean"
        },
        "receiptUrl": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "createdByUserId": {
          "type": "string"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "place"
      ]
    },
    "FixedCategoryItem": {
      "title": "FixedCategoryItem",
      "description": "Custom fixed-bill category stored on the user profile.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "color",
        "icon"
      ]
    },
    "SavingGoal": {
      "title": "SavingGoal",
      "description": "A global saving goal. Months move money into or out of it; it never resets at rollover.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "current": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "source": {
          "type": "string",
          "enum": [
            "bank",
            "home",
            "wallet"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "current",
        "source",
        "active"
      ]
    },
    "DebtItem": {
      "title": "DebtItem",
      "description": "Money owed to someone ('debt') or owed to the user ('credit').",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Person or entity on the other side"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "type": {
          "type": "string",
          "enum": [
            "debt",
            "credit"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "settled"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 250
        }
      },
      "required": [
        "id",
        "name",
        "amount",
        "type",
        "status",
        "date"
      ]
    },
    "CustomRatios": {
      "title": "CustomRatios",
      "description": "User-defined allocation for the 'custom' strategy. Fractions of income that always sum to 1.",
      "type": "object",
      "properties": {
        "needs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wants": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "savings": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "needs",
        "wants",
        "savings"
      ]
    }
  },
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account configuration and plan details.",
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "enum": [
            "free",
            "pro"
          ],
          "description": "Pinned by firestore.rules \u2014 clients can never change it after creation"
        },
        "currency": {
          "type": "string",
          "maxLength": 10
        },
        "onboardingComplete": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "ar"
          ]
        },
        "householdMembers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultCategoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: default per-category budgets applied to new months"
        },
        "enableRollover": {
          "type": "boolean",
          "description": "Pro feature: carry unused category budget into the next month"
        },
        "fixedCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedCategoryItem"
          },
          "description": "User-defined fixed-bill categories shown in the Add Fixed Charge modal"
        },
        "activeHouseholdId": {
          "type": "string"
        },
        "householdIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeWorkspace": {
          "type": "string",
          "enum": [
            "personal",
            "household"
          ]
        }
      },
      "required": [
        "plan",
        "currency",
        "onboardingComplete"
      ]
    },
    "MonthBudget": {
      "title": "MonthBudget",
      "description": "Monthly budget state including money places and expenses.",
      "type": "object",
      "properties": {
        "totalBudget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Total income for the month"
        },
        "incomeSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IncomeSource"
          },
          "description": "Defaults to a single 'Primary Income' source equal to totalBudget"
        },
        "bankPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "homePart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "walletPart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "strategyId": {
          "type": "string",
          "enum": [
            "50-30-20",
            "70-20-10",
            "80-20",
            "zero-based",
            "envelope",
            "pay-first",
            "custom"
          ]
        },
        "customRatios": {
          "$ref": "#/definitions/CustomRatios",
          "description": "Definable Needs/Wants/Savings split, applied when strategyId is 'custom'"
        },
        "monthlySavingsTarget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "variableExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VariableExpense"
          },
          "maxItems": 2000
        },
        "fixedExpenses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedExpense"
          },
          "maxItems": 500
        },
        "categoryBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: planned maximum per category for the month"
        },
        "rolloverFromPrevious": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pro feature: unused category budgets rolled over from the previous month"
        },
        "variableCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for variable spending"
        },
        "fixedCategoryBases": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Planned amount per category for fixed bills"
        },
        "activeCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categoryColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to hex colour, e.g. #f97316"
        },
        "categoryIcons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Category name to Material Symbols icon name"
        },
        "debts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebtItem"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the last write"
        },
        "updatedByUserId": {
          "type": "string"
        }
      },
      "required": [
        "totalBudget",
        "bankPart",
        "homePart",
        "walletPart",
        "strategyId",
        "monthlySavingsTarget",
        "variableExpenses",
        "fixedExpenses",
        "variableCategoryBases",
        "fixedCategoryBases",
        "activeCategories",
        "categoryColors",
        "categoryIcons",
        "updatedAt"
      ]
    },
    "SavingsData": {
      "title": "SavingsData",
      "description": "Global savings goals list for the user.",
      "type": "object",
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SavingGoal"
          },
          "maxItems": 200
        }
      },
      "required": [
        "goals"
      ]
    },
    "Household": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "planOwnerId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "ownerId",
        "planOwnerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "HouseholdMember": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "avatarColor": {
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "role",
        "status",
        "avatarColor"
      ]
    },
    "HouseholdInvite": {
      "type": "object",
      "properties": {
        "householdId": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "householdId",
        "memberId",
        "email",
        "role",
        "createdBy",
        "createdAt",
        "expiresAt",
        "status"
      ]
    },
    "HouseholdInvoice": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "payerMemberId": {
          "type": "string"
        },
        "submitterId": {
          "type": "string"
        },
        "receiptUrl": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "approved",
            "rejected"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "amount",
        "category",
        "date",
        "payerMemberId",
        "submitterId",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{uid}/months/{monthKey}": {
      "schema": "MonthBudget",
      "description": "Monthly budget records",
      "idPattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "/users/{uid}/data/savings": {
      "schema": "SavingsData",
      "description": "Global savings goals document"
    },
    "/households/{monthKey}": {
      "schema": "Household",
      "description": "Shared household workspace"
    },
    "/households/{monthKey}/members/{monthKey}": {
      "schema": "HouseholdMember",
      "description": "Household membership and roles"
    },
    "/householdInvites/{monthKey}": {
      "schema": "HouseholdInvite",
      "description": "Email-bound household invitation"
    },
    "/households/{monthKey}/months/{monthKey}": {
      "schema": "MonthBudget",
      "description": "Shared monthly budget",
      "idPattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "/households/{monthKey}/data/savings": {
      "schema": "SavingsData",
      "description": "Shared savings goals"
    },
    "/households/{monthKey}/invoices/{monthKey}": {
      "schema": "HouseholdInvoice",
      "description": "Contributor invoice submissions isolated from private budgets"
    }
  }
}
