rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isMoney(val) { return val is number && val >= 0 && val <= 1000000000; }
    function isValidMonthId(id) { return id.matches('^[0-9]{4}-[0-9]{2}$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function householdMember(hid) { return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.status == 'active'; }
    function householdEditor(hid) { return householdMember(hid) && get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role in ['owner', 'editor']; }
    function householdOwner(hid) { return signedIn() && get(/databases/$(database)/documents/households/$(hid)).data.ownerId == request.auth.uid; }

    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && request.resource.data.plan == 'free' && request.resource.data.currency is string && request.resource.data.onboardingComplete is bool;
      allow update: if owner(uid) && incoming().plan == existing().plan && request.resource.data.currency is string && request.resource.data.onboardingComplete is bool;
      allow delete: if owner(uid);
      match /months/{key} { allow read: if owner(uid); allow write: if owner(uid) && isValidMonthId(key) && isMoney(incoming().totalBudget) && isMoney(incoming().bankPart) && isMoney(incoming().homePart) && isMoney(incoming().walletPart) && (!('variableExpenses' in request.resource.data) || incoming().variableExpenses.size() <= 2000) && (!('fixedExpenses' in request.resource.data) || incoming().fixedExpenses.size() <= 500); }
      match /data/savings { allow read: if owner(uid); allow write: if owner(uid) && (!('goals' in request.resource.data) || incoming().goals.size() <= 200); }
    }

    match /households/{hid} {
      allow get: if householdMember(hid) || householdOwner(hid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'pro';
      allow update, delete: if householdOwner(hid) && request.resource.data.ownerId == resource.data.ownerId;
      match /members/{memberId} {
        allow get: if householdMember(hid) || householdOwner(hid) || (signedIn() && resource.data.email == request.auth.token.email);
        allow list: if householdMember(hid) || householdOwner(hid);
        allow create: if householdOwner(hid) || (memberId == request.auth.uid && request.resource.data.userId == request.auth.uid);
        allow update: if householdOwner(hid)
          // A recipient activates their UID-indexed membership after accepting.
          || (memberId == request.auth.uid && resource.data.email == request.auth.token.email && request.resource.data.userId == request.auth.uid)
          // Then the recipient retires the email-bound pending member record.
          || (resource.data.email == request.auth.token.email
            && resource.data.status == 'invited'
            && request.resource.data.status == 'inactive'
            && request.resource.data.userId == request.auth.uid);
        allow delete: if householdOwner(hid);
      }
      // Contributor invoices are isolated from private monthly balances, debts and savings.
      match /invoices/{invoiceId} {
        allow get: if householdEditor(hid) || (signedIn() && resource.data.submitterId == request.auth.uid);
        allow list: if householdEditor(hid);
        allow create: if householdMember(hid)
          && get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role in ['owner', 'editor', 'contributor']
          && request.resource.data.submitterId == request.auth.uid
          && request.resource.data.status == 'submitted';
        allow update: if householdEditor(hid);
        allow delete: if householdOwner(hid);
      }

      match /months/{key} { allow read: if householdMember(hid); allow write: if householdEditor(hid) && isValidMonthId(key) && isMoney(incoming().totalBudget) && isMoney(incoming().bankPart) && isMoney(incoming().homePart) && isMoney(incoming().walletPart) && (!('variableExpenses' in request.resource.data) || incoming().variableExpenses.size() <= 2000) && (!('fixedExpenses' in request.resource.data) || incoming().fixedExpenses.size() <= 500); }
      match /data/savings { allow read: if householdMember(hid); allow write: if householdEditor(hid) && (!('goals' in request.resource.data) || incoming().goals.size() <= 200); }
    }
    match /householdInvites/{inviteId} {
      allow get: if signedIn() && (resource.data.email == request.auth.token.email || householdOwner(resource.data.householdId));
      // A recipient's query is constrained to their own email by the client query.
      allow list: if signedIn() && resource.data.email == request.auth.token.email;
      allow create: if signedIn() && householdOwner(request.resource.data.householdId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (householdOwner(resource.data.householdId) || (resource.data.email == request.auth.token.email && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
