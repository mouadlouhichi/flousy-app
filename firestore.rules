rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Email identity is compared case-insensitively. The client lowercases on
    // write and on query, but the `email` claim is echoed from the identity
    // provider and is NOT guaranteed lowercase for every provider or import
    // path. A verbatim comparison made invite discovery return nothing and the
    // acceptance batch deny for a token carrying `Foo@Example.com` - a failure
    // indistinguishable from an expired invite, with nothing to diagnose it.
    // Total on purpose: `.lower()` on a non-string aborts evaluation, and an
    // aborted rule reaches the client as a bare permission-denied.
    function emailMatches(value) {
      return signedIn()
        && request.auth.token.email is string
        && value is string
        && value.lower() == request.auth.token.email.lower();
    }
    function isMoney(value) { return value is number && value >= 0 && value <= 1000000000; }
    function isPositiveMoney(value) { return isMoney(value) && value > 0; }
    // `id is string` first: `matches()` on a field the document never stored aborts the
    // rule, and an aborted evaluation reaches the client as a bare permission-denied -
    // indistinguishable from this predicate simply answering no, which is the answer a
    // malformed month key should get.
    function isValidMonthId(id) { return id is string && id.matches('^[0-9]{4}-[0-9]{2}$'); }
    // Both are total on purpose. Firestore evaluates the `update` rules for a
    // `set()` on a document that does not exist yet, and `resource` is null in
    // that request: reading `resource.data` there is an evaluation error, which
    // the client sees as a plain permission-denied - so an ordinary first write to
    // a month document would be refused for the wrong reason, and a bootstrap
    // diff would abort instead of reporting every key as added.
    function incoming() { return request.resource == null ? {} : request.resource.data; }
    function existing() { return resource == null ? {} : resource.data; }
    function isEmail(value) { return value is string && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }
    function boundedText(value, maxBytes) {
      return value is string && value.size() > 0 && value.size() <= maxBytes;
    }
    function entitlementFieldsChanged() {
      return incoming().diff(existing()).affectedKeys().hasAny([
        'plan', 'entitlementSource', 'entitlementStatus',
        'entitlementStartedAtMs', 'entitlementEndsAtMs',
        'proTrialClaimedAt', 'planBillingCycle', 'planNextBillingDate'
      ]);
    }
    function validLaunchTrialClaim() {
      // A profile created and claimed in one `set()` has no existing document, and
      // `existing()` is deliberately an empty map there: reading `plan` off it as a
      // property aborts, which reaches the client as a plain denial. "No profile yet"
      // and "a free profile" are the same answer to this question.
      return existing().get('plan', 'free') == 'free'
        && incoming().get('plan', '') == 'pro'
        && !('entitlementSource' in existing())
        && !('proTrialClaimedAt' in existing())
        && incoming().get('entitlementSource', '') == 'launch_trial'
        && incoming().get('entitlementStatus', '') == 'trialing'
        && incoming().get('entitlementStartedAtMs', -1) is int
        && incoming().get('entitlementStartedAtMs', -1) >= request.time.toMillis() - 300000
        && incoming().get('entitlementStartedAtMs', -1) <= request.time.toMillis() + 300000
        && incoming().get('entitlementEndsAtMs', 0)
          == incoming().get('entitlementStartedAtMs', -1) + 7776000000
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'plan', 'entitlementSource', 'entitlementStatus',
          'entitlementStartedAtMs', 'entitlementEndsAtMs'
        ]);
    }
    /* ---------------------------- entitlement ----------------------------
     * Every household write is authorized by re-reading the sponsor's profile.
     * Three things used to surface as an unexplainable permission-denied for
     * accounts whose Pro plan is plainly active:
     *   - `.data.entitlementOwnerId` on a household that predates the field,
     *     `get(users/$(uid)).data` on a deleted sponsor, and `plan == 'Pro'`
     *     typed by hand in the console. Each of those ABORTS evaluation, and an
     *     aborted rule is indistinguishable from a denial on the client.
     *   - a plan value the client accepts and the server does not:
     *     isProPlan() in src/lib/pro-features.ts is deliberately tolerant of the
     *     casing/whitespace that console edits and migrations leave behind.
     * So the helpers below are total: every field is read with get(key, default),
     * every comparison is type-guarded, and -1 means "no such value" wherever a
     * millisecond figure is expected.
     */
    function userProfileData(uid) {
      return uid is string
        && uid.size() > 0
        && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data
        : {};
    }
    function isProPlanValue(value) {
      return value is string && value.trim().lower() == 'pro';
    }
    /**
     * Entitlement tokens are compared the way the client compares them: the
     * enum spelling is what matters, not the casing or padding a hand-edited
     * document happens to carry.
     */
    function tokenValue(value) {
      return value is string ? value.trim().lower() : '';
    }
    function millisOrMissing(value) {
      return value is number && value > 0 ? value : -1;
    }
    function profileEntitlementEndsAtMs(profile) {
      return millisOrMissing(profile.get('entitlementEndsAtMs', -1));
    }
    /** Single source of truth for "may this profile spend its Pro entitlement". */
    function profileIsPro(profile, nowMs) {
      // Every read and comparison is inline, in this one place, on purpose.
      // Rules *inline* each function call into the caller's expression budget
      // (a request may evaluate at most 1000 expressions), and this is the most
      // repeated condition in the file: composing tokenValue()/millisOrMissing()/
      // isProPlanValue() here multiplied the cost of every household finance write
      // until the engine refused them outright. Those helpers stay as they were for
      // the paths that use them once - this is the only copy of the decision.
      let plan = profile.get('plan', '');
      let source = profile.get('entitlementSource', '');
      let status = profile.get('entitlementStatus', '');
      let ends = profile.get('entitlementEndsAtMs', -1);
      let sourceToken = source is string ? source.trim().lower() : '';
      let statusToken = status is string ? status.trim().lower() : '';
      let endsAtMs = ends is number && ends > 0 ? ends : -1;
      // A launch trial is a closed period: without a usable end time there is no
      // entitlement to spend, exactly as resolveProEntitlement() decides. A
      // provider grant (stripe/cmi/admin) with no end time is unbounded.
      return plan is string && plan.trim().lower() == 'pro'
        && (sourceToken == 'launch_trial'
          ? (endsAtMs >= 0 && endsAtMs > nowMs)
          : ((statusToken == '' || statusToken in ['trialing', 'active', 'grace_period', 'canceled'])
            && (endsAtMs < 0 || endsAtMs > nowMs)));
    }
    /**
     * A projected entitlement field the household document may carry for a
     * sponsor: either the sponsor's own value, or - for a grant that spells
     * nothing out - the 'active' the client derives from it. Nothing here can
     * overstate the sponsor's profile, because the expiry has to match it
     * exactly and `profileIsPro` is what licenses the optimistic spelling.
     */
    // `pro` is the caller's already-computed `profileIsPro` answer: the two callers both
    // require it before they get here, so recomputing it inside cost the largest helper
    // in the file a third expansion of the profile read for no additional guarantee.
    function entitlementProjectionAgrees(data, profile, field, pro) {
      let profileValue = tokenValue(profile.get(field, ''));
      let nextValue = tokenValue(data.get(field, ''));
      return profileValue == ''
        || nextValue == profileValue
        || (field == 'entitlementStatus' && nextValue == 'active' && pro);
    }
    function activeProEntitlement(uid) {
      // The profile is read once and named: `profileIsPro` looks at four fields of it,
      // and a document read passed as an argument is expanded at every use.
      let profile = userProfileData(uid);
      return profileIsPro(profile, request.time.toMillis());
    }
    /**
     * Sponsor of a household's plan. Legacy documents store only `ownerId`,
     * and normalizeHousehold() in src/lib/db.ts already resolves this same
     * chain for the UI - the server has to agree or those households end up
     * writable by nobody.
     */
    function householdSponsor(data) {
      let explicit = data.get('entitlementOwnerId', '');
      let billing = data.get('planOwnerId', '');
      let creator = data.get('ownerId', '');
      // The same `a || b || c` chain normalizeHousehold() runs, including its
      // treatment of an empty string as "not set".
      return explicit is string && explicit.size() > 0 ? explicit
        : (billing is string && billing.size() > 0
          ? billing
          : (creator is string ? creator : ''));
    }
    // The entitlement question asked of a household document already in scope - the
    // same owner/editor gate and the same sponsor chain, without re-fetching the root.
    function householdEntitledFor(data) {
      return activeProEntitlement(householdSponsor(data));
    }
    function householdEntitled(hid) {
      // The household document is read through `exists()` first so an absent one
      // answers "no entitlement" instead of aborting: an aborted rule and a denial
      // are the same `permission-denied` to the client, and a denial the client
      // cannot explain is the bug this block exists to remove.
      let data = exists(householdPath(hid)) ? get(householdPath(hid)).data : {};
      return activeProEntitlement(householdSponsor(data));
    }
    function validHouseholdEntitlementProjection(data, uid) {
      let profile = userProfileData(uid);
      let nowMs = request.time.toMillis();
      let pro = profileIsPro(profile, nowMs);
      return data.get('entitlementOwnerId', '') == uid
        && pro
        && entitlementProjectionAgrees(data, profile, 'entitlementSource', pro)
        && entitlementProjectionAgrees(data, profile, 'entitlementStatus', pro)
        && millisOrMissing(data.get('entitlementEndsAtMs', -1)) == profileEntitlementEndsAtMs(profile);
    }
    /**
     * (Re)binding of the household's plan sponsor and its readable projection.
     * Two legitimate repairs share one shape, so both go through here:
     *   - a legacy household that never stored `entitlementOwnerId`, and
     *   - a household stranded behind a sponsor whose plan lapsed, which the
     *     owner unblocks by binding their own active entitlement (before this,
     *     the only in-app recovery was deleting the shared workspace).
     * Only the household owner can reach this branch, the sponsor may only be
     * bound to the caller's own account, the projected values must equal what
     * that account really holds, and no other field may move - so it cannot be
     * used to widen anyone's access.
     */
    function householdSponsorBindingValid(data, uid) {
      let profile = userProfileData(uid);
      let nowMs = request.time.toMillis();
      let pro = profileIsPro(profile, nowMs);
      let changed = data.diff(existing()).affectedKeys();
      return data.get('entitlementOwnerId', '') == uid
        && pro
        && entitlementProjectionAgrees(data, profile, 'entitlementSource', pro)
        && entitlementProjectionAgrees(data, profile, 'entitlementStatus', pro)
        && millisOrMissing(data.get('entitlementEndsAtMs', -1)) == profileEntitlementEndsAtMs(profile)
        && changed.hasOnly([
          'entitlementOwnerId', 'entitlementSource', 'entitlementStatus', 'entitlementEndsAtMs',
          'schemaVersion', 'updatedAt'
        ]);
    }
    // The ledger row a write must carry, validated once. Every read is defaulted: an
    // audit record missing `baseRevision` should be refused as the malformed row it is,
    // not turned into an evaluation error - and `mutationId` in the path is compared
    // rather than trusted, because the row is the replay guard for the month document.
    function ledgerRowAgrees(scopeId, mutationId, workspace) {
      let row = incoming();
      return row.get('mutationId', '') == mutationId
        && row.get('actorId', '') == request.auth.uid
        && row.get('workspace', '') == workspace
        && row.get('workspaceId', '') == scopeId
        && row.get('monthKey', '') is string
        && row.get('baseRevision', -1) is int
        && row.get('baseRevision', -1) >= 0
        && row.get('nextRevision', 0) == row.get('baseRevision', -1) + 1
        && row.get('createdAt', '') is string
        && row.get('kind', '') in [
          'bootstrap', 'savings-bootstrap', 'savings', 'month', 'month-and-savings',
          'month-close', 'month-reopen', 'course-post', 'invoice-approval'
        ];
    }

    /**
     * The period/audit half of the month shape check. Split out so a
     * close/reopen - which may only touch period-state keys - does not also pay
     * for re-validating money fields it cannot have changed. The cap is 1000
     * expressions per request and an over-budget write is refused outright.
     */
    function validMonthPeriodFields() {
      let after = incoming();
      let revision = after.get('revision', 0);
      let lastMutationId = after.get('lastMutationId', '');
      let periodStatus = after.get('periodStatus', '');
      let closedByUserId = after.get('closedByUserId', '');
      return revision is int
        && revision >= 1
        && lastMutationId is string
        && lastMutationId.size() > 0
        && lastMutationId.size() <= 160
        && (!('periodStatus' in after) || periodStatus in ['open', 'closed'])
        && (!('periodStatus' in after)
          || periodStatus != 'closed'
          || (after.get('closedAt', '') is string && closedByUserId is string
            && closedByUserId.size() > 0));
    }

    function validMonthDocument() {
      // Every field is read once and named. A rules function inlines its arguments at
      // each use, so a validator that asks for `revision` twice pays for the read twice -
      // and this one runs for every month write, personal and shared, in the same
      // request as the entitlement chain.
      let after = incoming();
      let totalBudget = after.get('totalBudget', null);
      let bankPart = after.get('bankPart', null);
      let homePart = after.get('homePart', null);
      let walletPart = after.get('walletPart', null);
      let revision = after.get('revision', 0);
      let lastMutationId = after.get('lastMutationId', '');
      let periodStatus = after.get('periodStatus', '');
      let closedByUserId = after.get('closedByUserId', '');
      let currency = after.get('currency', '');
      return isMoney(totalBudget)
        && isMoney(bankPart)
        && isMoney(homePart)
        && isMoney(walletPart)
        && revision is int
        && revision >= 1
        && lastMutationId is string
        && lastMutationId.size() > 0
        && lastMutationId.size() <= 160
        && (!('periodStatus' in after) || periodStatus in ['open', 'closed'])
        && (!('periodStatus' in after)
          || periodStatus != 'closed'
          || (after.get('closedAt', '') is string && closedByUserId is string
            && closedByUserId.size() > 0))
        && (!('currency' in after) || (currency is string && currency.size() >= 3 && currency.size() <= 8))
        // Firestore Rules cannot iterate arbitrary list/map values. The client
        // schema validates each entry; rules enforce collection shape and
        // bounded cardinality before accepting the document.
        && (!('variableExpenses' in after) || (after.variableExpenses is list
          && after.variableExpenses.size() <= 2000))
        && (!('fixedExpenses' in after) || (after.fixedExpenses is list
          && after.fixedExpenses.size() <= 500))
        && (!('savingsActivity' in after) || (after.savingsActivity is list
          && after.savingsActivity.size() <= 200))
        && (!('debts' in after) || (after.debts is list && after.debts.size() <= 500))
        && (!('transfers' in after) || (after.transfers is list && after.transfers.size() <= 500))
        && (!('balanceAdjustments' in after) || (after.balanceAdjustments is list
          && after.balanceAdjustments.size() <= 500))
        && (!('placeBalances' in after) || after.placeBalances is map);
    }

    function periodClosed(data) {
      return 'periodStatus' in data && data.periodStatus == 'closed';
    }
    function periodStateOnly() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'periodStatus', 'closedAt', 'closedByUserId', 'schemaVersion',
        'revision', 'lastMutationId', 'updatedAt', 'updatedByUserId'
      ]);
    }
    // Open periods accept ordinary finance writes. Closing is allowed to
    // normalize a legacy document, but reopening a frozen snapshot may alter
    // state/audit metadata only; finance edits require a later transaction.
    function periodTransitionOk(wasClosed, willBeClosed, stateOnly) {
      return (!wasClosed && !willBeClosed)
        || (!wasClosed && willBeClosed
          // Read through `get()` with a default: this is evaluated before the
          // document's own shape rule, and a missing field on a map is an
          // evaluation error rather than a false.
          && incoming().get('closedByUserId', '') == request.auth.uid)
        || (wasClosed && !willBeClosed
          && 'periodStatus' in incoming()
          && incoming().get('periodStatus', '') == 'open'
          && stateOnly);
    }
    function validPeriodStateTransition() {
      let wasClosed = periodClosed(existing());
      let willBeClosed = periodClosed(incoming());
      return periodTransitionOk(wasClosed, willBeClosed, periodStateOnly());
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }
    function memberPath(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }
    function monthPath(hid, key) {
      return /databases/$(database)/documents/households/$(hid)/months/$(key);
    }
    function ledgerPath(hid, key) {
      return /databases/$(database)/documents/households/$(hid)/ledger/$(key);
    }
    function savingsPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/data/savings;
    }
    /**
     * The caller's membership row, read as one expression. `exists()` and `get()`
     * are otherwise a pair per call site, and every helper that asked its own
     * question of the member document paid for the lookup again.
     */
    function memberDocument(hid) {
      return signedIn() && exists(memberPath(hid, request.auth.uid))
        ? get(memberPath(hid, request.auth.uid)).data
        : {};
    }
    function householdMember(hid) {
      return memberDocument(hid).get('status', '') == 'active';
    }
    function memberRole(hid) {
      return memberDocument(hid).get('role', '');
    }
    // An approved invoice must land in the month it names, and that month's write must
    // be the invoice's own. The document is read twice because a rule cannot tell
    // whether this write created it, so the path is built once and every read is
    // total: a month with no `revision` yet is a month being created, and an approval
    // that never sent `postedMonthKey` is a malformed write, not an aborted rule.
    function invoicePostedMonthOk(hid, invoiceId) {
      let key = incoming().get('postedMonthKey', '');
      let path = /databases/$(database)/documents/households/$(hid)/months/$(key);
      return isValidMonthId(key)
        && existsAfter(path)
        && getAfter(path).data.get('lastMutationId', '') == 'invoice-approval-' + invoiceId
        && ((!exists(path) && getAfter(path).data.get('revision', 0) == 1)
          || (exists(path)
            && getAfter(path).data.get('revision', 0) == get(path).data.get('revision', 0) + 1));
    }

    function householdOwner(hid) {
      // `ownerId` is pinned to the creator at create time and frozen against
      // every writer below, so it is the authoritative ownership record.
      // Only one copy of it is read: `getAfter` exists because a household can be
      // created in the same batch as its owner's membership row, where the root
      // document does not exist yet for `get()`. Asking both on every write was
      // affordable until the entitlement chain grew; a shared write then ran into
      // the 1000-expression cap, and an over-cap request is just a denial.
      // A stored id reaches this function from the invitation rules, and an empty one
      // builds a path Firestore rejects - which the client sees as a plain
      // permission-denied. Checked here because every caller reads documents first.
      return hid != ''
        && signedIn()
        && (request.method == 'create'
          ? (existsAfter(householdPath(hid))
            && getAfter(householdPath(hid)).data.get('ownerId', '') == request.auth.uid)
          : (exists(householdPath(hid))
            && get(householdPath(hid)).data.get('ownerId', '') == request.auth.uid));
    }
    /**
     * Writers of the shared budget. The household's own owner counts even when
     * their membership row is missing or stale: households created before the
     * owner row was batched into `members/` used to be readable by their owner
     * and writable by nobody, which reads as a lost budget rather than as a
     * permission problem.
     */
    function householdEditor(hid) {
      let member = memberDocument(hid);
      return householdOwner(hid)
        || (member.get('status', '') == 'active'
          && (member.get('role', '') == 'owner' || member.get('role', '') == 'editor'));
    }
    function householdWriter(hid) {
      return householdEditor(hid) && householdEntitled(hid);
    }
    /**
     * Shared-finance write gates. They exist so that one rule asks
     * `householdEntitled()` and the membership row ONCE each: rules inline every
     * call into the caller's expression budget, a request may evaluate at most
     * 1000 expressions, and `(householdWriter(hid) || customMonthWriter(hid))` -
     * two helpers that each re-derived the same answers - quietly exceeded it for a
     * custom member's month write, which the client only ever sees as a denial.
     * The three conditions are the same ones those helpers enforced; `grantsChecked`
     * adds the per-area key diff only custom writers are subject to.
     */
    /**
     * One pass over the household root and the caller's membership row, answering
     * every question a shared write asks. Rules inline a call into the caller's
     * budget, so a gate that asked three helpers for the same document paid for it
     * three times; the gates below read it once between them instead.
     * `scripts/rules-budget.mjs` estimates that budget and CI enforces it.
     */
    // Who owns this household, and does somebody pay for it - the two questions the
    // member rules ask repeatedly, from one read of the household root. `householdOwner`
    // and `householdEntitled` each fetch that document on their own, so a rule with
    // three branches used to expand the same path and the same `get()` three times over;
    // a rule that outgrows the request's 1000-expression budget is refused with a plain
    // permission-denied, which is the least diagnosable failure a client can be given.
    // The `create` case reads the after-state because a household and its owner's
    // membership row are written in one batch by both onboarding and this app's repair.
    //
    // MAP LITERAL KEYS ARE QUOTED, HERE AND IN EVERY RECORD BELOW. In the rules
    // language `{ owner: ... }` is not a JavaScript object: the map-literal grammar
    // takes an *expression* on each side of the colon, so a bare `owner` is resolved
    // as a name - `owner(uid)` the function, an unbound identifier, or the value of a
    // `let` binding of the same name - instead of the string 'owner'. The engine then
    // aborts building the map ("Null value error", or "Type error. Received: [bool]
    // Expected: [string]" when the key happened to be bound to a boolean, exactly what
    // `present: present` produced in `mutationLedger`). An aborted rule is reported to
    // the client as a bare permission-denied, which is how every shared month write
    // - import, outbox flush, close/reopen, membership edit - failed for an owner whose
    // entitlement, membership and ownership were all in order (CI run 33893291607).
    // `tests/firestore-rules.emulator.ts` drives every record-returning helper.
    function householdRootFacts(hid) {
      let uid = signedIn() ? request.auth.uid : '';
      let path = householdPath(hid);
      let root = request.method == 'create'
        ? (existsAfter(path) ? getAfter(path).data : {})
        : (exists(path) ? get(path).data : {});
      return {
        'owner': uid != '' && root.get('ownerId', '') == uid,
        'signedIn': uid != '',
        'paid': uid != '' && activeProEntitlement(householdSponsor(root))
      };
    }
    function householdAccess(hid) {
      let uid = signedIn() ? request.auth.uid : '';
      // Paths are built once: a `get()` and the `exists()` that guards it would
      // otherwise construct the same path twice, and every shared write builds all
      // three of them.
      let hPath = householdPath(hid);
      // `getAfter` because a household can be created in the same batch as its
      // owner's membership row, where the root does not exist yet for `get()`.
      let root = request.method == 'create'
        ? (existsAfter(hPath) ? getAfter(hPath).data : {})
        : (exists(hPath) ? get(hPath).data : {});
      let mPath = memberPath(hid, uid);
      let member = uid != '' && exists(mPath) ? get(mPath).data : {};
      let role = member.get('role', '');
      // Whether somebody in this household pays for it is asked once per rule and
      // shared by all three writer branches, and it is asked of the payer's profile
      // rather than of the projection on the household: a projection is only ever
      // written after being verified against that profile, but nothing forces it to
      // be refreshed when the profile changes, and a shared write must not outlive
      // the plan that pays for it.
      let sponsor = householdSponsor(root);
      return {
        'owner': uid != '' && root.get('ownerId', '') == uid,
        'editor': member.get('status', '') == 'active'
          && (role == 'owner' || role == 'editor'),
        'custom': isCustomMember(member),
        'permissions': member.get('permissions', {}),
        'paid': sponsor != '' && activeProEntitlement(sponsor)
      };
    }
    function householdLedgerGate(hid) {
      let access = householdAccess(hid);
      // Custom members may ledger ordinary finance mutations; closing, reopening
      // and approving stay with owners and editors.
      let ordinaryKind = incoming().get('kind', '') in [
        'bootstrap', 'savings-bootstrap', 'savings', 'month', 'month-and-savings', 'course-post'
      ];
      return access.paid && (access.owner || access.editor
        || (access.custom && 'editAll' in access.permissions.values() && ordinaryKind));
    }
    function householdSavingsGate(hid) {
      let access = householdAccess(hid);
      return access.paid && (access.owner || access.editor
        || (access.custom && access.permissions.get('savings', 'none') == 'editAll'));
    }
    /**
     * The ledger row a shared finance write is being replayed for. Rules have no
     * cache between documents, so each rule spelled out the same path literal per
     * lookup and re-derived `incoming()` inside it; three documents in one
     * transaction then spent a third of the 1000-expression request budget on
     * repetition. The path is built once here, the row is read once, and the shape
     * of the key is checked with it.
     */
    function mutationLedger(hid) {
      let key = incoming().get('lastMutationId', '');
      // A key that could not have been accepted by the ledger rules is refused here
      // instead of being interpolated into a path: an unusable path is an evaluation
      // error, and an evaluation error reaches the client as a plain denial.
      let usable = key is string && key.size() > 0 && key.size() <= 160;
      let path = ledgerPath(hid, usable ? key : 'absent');
      let present = usable && existsAfter(path);
      return {
        'present': present,
        'kind': present ? getAfter(path).data.get('kind', '') : ''
      };
    }
    /**
     * Everything the shared month document's update rule asks, in one pass: who
     * pays for the workspace and who may write it, the ledger row replaying the
     * mutation, the period's transition and the revision. It is a single function
     * because rules inline every call into one per-request budget of 1000 evaluated
     * expressions - a flush then writes the ledger row, the month and the savings
     * document from the same budget, and asking the household root twice per
     * document is what made an outbox flush fail. Closing and reopening need their
     * own ledger kind; only the household's owner may change period state without
     * it, and a bootstrap row never replays a month.
     */
    /*
     * Shared-month writes, split by writer kind.
     *
     * Rules inline every call into ONE per-request budget of 1000 evaluated
     * expressions, and an over-budget request is refused with a bare
     * `permission-denied` before any branch runs. Folded into a single
     * function these cost ~1574 (update) and ~1288 (create) - so importing a
     * budget, flushing the outbox and deleting a workspace all failed on
     * arithmetic rather than authorization, and the client reported it as
     * "the published rules are behind" because a refusal it cannot explain is
     * indistinguishable from a stale deployment.
     *
     * These helpers deliberately do NOT go through `householdAccess()`: that
     * record resolves the owner, editor, custom and permission questions
     * together, and each branch below needs only some of them. Reading the two
     * documents directly is the same authorization, at a third of the cost.
     */

    /**
     * Month-write facts, in two flavours so a branch never computes a fact it
     * does not use. Rules evaluate the whole returned map, so a single
     * all-purpose record charges every caller for the owner, editor, custom AND
     * permission questions - which is what pushed these rules over the cap.
     */

    /** Owner/editor flavour: ownership, editorship and who pays. */
    function monthFinanceWriterFacts(hid) {
      let uid = signedIn() ? request.auth.uid : '';
      let hPath = householdPath(hid);
      let root = request.method == 'create'
        ? (existsAfter(hPath) ? getAfter(hPath).data : {})
        : (exists(hPath) ? get(hPath).data : {});
      let mPath = memberPath(hid, uid);
      let member = uid != '' && exists(mPath) ? get(mPath).data : {};
      let role = member.get('role', '');
      // Bound to a name: passed inline this expression is re-expanded at each of
      // `userProfileData()`'s uses of it.
      let sponsor = householdSponsor(root);
      return {
        'owner': uid != '' && root.get('ownerId', '') == uid,
        'editor': member.get('status', '') == 'active' && (role == 'owner' || role == 'editor'),
        'paid': uid != '' && sponsor != '' && activeProEntitlement(sponsor)
      };
    }

    /** Custom-member flavour: the grant map and who pays. */
    function monthCustomWriterFacts(hid) {
      let uid = signedIn() ? request.auth.uid : '';
      let hPath = householdPath(hid);
      let root = request.method == 'create'
        ? (existsAfter(hPath) ? getAfter(hPath).data : {})
        : (exists(hPath) ? get(hPath).data : {});
      let mPath = memberPath(hid, uid);
      let member = uid != '' && exists(mPath) ? get(mPath).data : {};
      let sponsor = householdSponsor(root);
      return {
        'custom': isCustomMember(member),
        'permissions': member.get('permissions', {}),
        'paid': uid != '' && sponsor != '' && activeProEntitlement(sponsor)
      };
    }

    /**
     * The ordinary case: an open period staying open. This is what an import,
     * an outbox flush and every normal edit do, so it is kept as cheap as
     * possible - no transition machinery, no ownership question.
     */
    function monthOrdinaryUpdateOk(hid) {
      let row = mutationLedger(hid);
      let revWas = existing().get('revision', -1);
      let revNext = incoming().get('revision', 0);
      return !periodClosed(existing())
        && !periodClosed(incoming())
        && row.present && row.kind != 'bootstrap'
        && ((revWas == -1 && revNext == 1) || (revWas is int && revNext == revWas + 1));
    }

    /** Ledger row, close/reopen transition and revision successor. */
    function monthUpdatePreconditions(hid, isOwner) {
      let row = mutationLedger(hid);
      let wasClosed = periodClosed(existing());
      let willBeClosed = periodClosed(incoming());
      let revWas = existing().get('revision', -1);
      let revNext = incoming().get('revision', 0);
      return row.present && row.kind != 'bootstrap'
        && ((!wasClosed && !willBeClosed) || isOwner)
        && periodTransitionOk(wasClosed, willBeClosed, periodStateOnly())
        && ((!wasClosed && !willBeClosed)
          || (!wasClosed && willBeClosed && row.kind == 'month-close')
          || (wasClosed && !willBeClosed && row.kind == 'month-reopen'))
        // `revision` starts at 1 and moves by exactly one, so a document written
        // before the field carried a number accepts 1 and every later write has to
        // be the successor of what is stored.
        && ((revWas == -1 && revNext == 1) || (revWas is int && revNext == revWas + 1));
    }

    /**
     * Owner or editor making an ordinary edit to an open period. The common
     * write, and the cheapest: closing and reopening go through
     * `monthCloseReopenByOwner` below.
     */
    function monthOrdinaryUpdateByFinanceWriter(hid) {
      let facts = monthFinanceWriterFacts(hid);
      return facts.paid
        && (facts.owner || facts.editor)
        && monthOrdinaryUpdateOk(hid);
    }

    /**
     * Closing or reopening a shared period: owner only, per the audit trail.
     * Reads the root once and never resolves the membership row - ownership is
     * recorded on the household document itself, and `editor`/`custom` are
     * irrelevant to a branch only an owner can take.
     */
    function monthCloseReopenByOwner(hid) {
      let uid = signedIn() ? request.auth.uid : '';
      let hPath = householdPath(hid);
      let root = exists(hPath) ? get(hPath).data : {};
      let sponsor = householdSponsor(root);
      return uid != ''
        && root.get('ownerId', '') == uid
        && sponsor != '' && activeProEntitlement(sponsor)
        && monthUpdatePreconditions(hid, true);
    }

    /**
     * Custom member updating the shared month: every changed key must fall in a
     * granted area, and the period must be open both before and after - closing
     * and reopening are owner operations.
     */
    function monthUpdateByCustomMember(hid) {
      let facts = monthCustomWriterFacts(hid);
      // Cheapest discriminators first: `customMonthChangesGranted` walks the
      // whole changed-key set against nine area grants, so it must not be
      // reached for a writer who was never a custom member to begin with.
      return facts.custom
        && facts.paid
        && 'editAll' in facts.permissions.values()
        && monthOrdinaryUpdateOk(hid)
        && customMonthChangesGranted(facts.permissions);
    }

    /**
     * Owner or editor creating (bootstrapping) a shared month document.
     * Importing a personal budget copies each month as `normalizeMonth()` stores
     * it, `periodStatus` included, so an archived (closed) month arrives closed.
     * Only the owner may put a shared period into that state - closing is an
     * owner operation everywhere else in this file - so a closed bootstrap is
     * accepted from the owner and refused from an editor, instead of the create
     * rule refusing every closed month and the import silently losing them.
     */
    function monthCreateByFinanceWriter(hid) {
      let facts = monthFinanceWriterFacts(hid);
      return facts.paid
        && (facts.owner || facts.editor)
        && (facts.owner || !periodClosed(incoming()));
    }

    /**
     * Custom member bootstrapping a shared month. A valid month document
     * structurally carries every area's keys, so creation cannot be split per
     * grant - `editAll` in any area is the gate, exactly as before. Ongoing
     * edits are the enforced surface (see the update rules).
     */
    function monthCreateByCustomMember(hid) {
      let facts = monthCustomWriterFacts(hid);
      return facts.paid && facts.custom && 'editAll' in facts.permissions.values();
    }

    /** A bootstrap row seeds the goals document; it may never rewrite it. */
    function savingsMutationAgrees(hid, bootstrapAllowed) {
      let row = mutationLedger(hid);
      return row.present && (bootstrapAllowed || row.kind != 'savings-bootstrap');
    }
    /**
     * A ledger row is accepted once the document it advances has taken the mutation,
     * which is what makes a replay idempotent instead of double-posted.
     */
    function mutationTargetAgrees(hid, mutationId) {
      let key = incoming().get('monthKey', '');
      let target = key == 'savings'
        ? savingsPath(hid)
        : monthPath(hid, key is string && isValidMonthId(key) ? key : '0000-00');
      return existsAfter(target)
        && getAfter(target).data.get('lastMutationId', '') == mutationId;
    }
    /**
     * `revision` starts at 1 and moves by exactly one, so a document written before
     * the field carried a number accepts 1 and every later write must be its
     * successor.
     */
    function validRevisionBump() {
      let was = existing().get('revision', -1);
      let next = incoming().get('revision', 0);
      return (was == -1 && next == 1) || (was is int && next == was + 1);
    }
    function householdFinanceReader(hid) {
      let member = memberDocument(hid);
      return member.get('status', '') == 'active'
        && member.get('role', '') in ['owner', 'editor', 'viewer'];
    }

    /* ----------------------- custom role (per-area grants) ----------------------- */
    // A `custom` member carries a `permissions` map on their member document
    // (area -> level). The map is only ever written by the household owner
    // (member create/update below validate its shape), so these helpers can
    // trust it as the authoritative grant source. The client mirrors the same
    // semantics in src/lib/household-rbac.ts.
    function customMember(hid) {
      return isCustomMember(memberDocument(hid));
    }
    /** The same question, for a caller who has already read the membership row. */
    function isCustomMember(member) {
      return member.get('status', '') == 'active' && member.get('role', '') == 'custom';
    }
    function customLevel(hid, area) {
      return memberDocument(hid).get('permissions', {}).get(area, 'none');
    }
    function customCanEditArea(hid, area) {
      let member = memberDocument(hid);
      return isCustomMember(member) && householdEntitled(hid)
        && member.get('permissions', {}).get(area, 'none') == 'editAll';
    }
    // Reading finance documents (months, ledger) is all-or-nothing per
    // document, so any finance-surface grant opens them; hiding individual
    // areas within a shared month document is client-side presentation.
    function customFinanceViewer(hid) {
      // Bound once via `let`: Firestore rules cap evaluation at 1000
      // expressions per request, so helpers must not re-expand the member
      // lookup per area (this cap is what CI's emulator suite enforces).
      let member = memberDocument(hid);
      let p = member.get('permissions', {});
      return member.get('status', '') == 'active' && member.get('role', '') == 'custom'
        && (p.get('dashboard', 'none') != 'none'
          || p.get('balances', 'none') != 'none'
          || p.get('income', 'none') != 'none'
          || p.get('expenses', 'none') != 'none'
          || p.get('fixedBills', 'none') != 'none'
          || p.get('savings', 'none') != 'none'
          || p.get('debts', 'none') != 'none'
          || p.get('analytics', 'none') != 'none');
    }
    // A custom member counts as a month writer when at least one month area is
    // granted editAll; which keys they may actually change is checked by
    // customMonthChangesGranted().
    function customMonthWriter(hid) {
      // One read of the membership row answers all three questions: the role, the
      // entitlement and the grant map. validCustomPermissions() caps every non-month
      // area below editAll, so any editAll value in the stored map is necessarily a
      // month-area grant.
      let member = memberDocument(hid);
      return member.get('status', '') == 'active'
        && member.get('role', '') == 'custom'
        && householdEntitled(hid)
        && 'editAll' in member.get('permissions', {}).values();
    }
    // Mirrors AREA_LEVEL_OPTIONS in src/lib/household-rbac.ts: month areas may
    // reach editAll (enforceable via affectedKeys), invoices tops out at
    // editOwn (approval posts into the month document and stays with
    // owner/editor), read surfaces and members/settings never exceed view.
    function validCustomPermissions(p) {
      return p.keys().hasOnly([
          'dashboard', 'balances', 'income', 'expenses', 'fixedBills', 'savings',
          'debts', 'analytics', 'invoices', 'members', 'settings'
        ])
        && p.get('dashboard', 'none') in ['none', 'view']
        && p.get('balances', 'none') in ['none', 'view', 'editAll']
        && p.get('income', 'none') in ['none', 'view', 'editAll']
        && p.get('expenses', 'none') in ['none', 'view', 'editAll']
        && p.get('fixedBills', 'none') in ['none', 'view', 'editAll']
        && p.get('savings', 'none') in ['none', 'view', 'editAll']
        && p.get('debts', 'none') in ['none', 'view', 'editAll']
        && p.get('analytics', 'none') in ['none', 'view']
        && p.get('invoices', 'none') in ['none', 'view', 'editOwn']
        && p.get('members', 'none') in ['none', 'view']
        && p.get('settings', 'none') in ['none', 'view'];
    }
    // Member documents may only carry a permissions map that the custom-role
    // helpers can safely interpret. Non-custom roles ignore the map, but a
    // stored one must still be well-formed so a later switch to `custom`
    // cannot resurrect grants the rules never accepted.
    function memberDocPermissionsValid() {
      // Named once: `validCustomPermissions` inspects twelve keys of it, and an
      // expression passed as an argument is expanded at each of those uses.
      let permissions = incoming().get('permissions', {});
      return !('permissions' in incoming()) || validCustomPermissions(permissions);
    }
    // Field-group enforcement for custom month updates. Every changed key
    // must belong to a granted area (or be sync bookkeeping). Recording money
    // movement necessarily updates the bank/home/wallet split, so those
    // derived keys ride along with any month-area grant (customMonthWriter is
    // already required on this path); direct budget/transfer/adjustment edits
    // additionally demand the balances grant, and totalBudget follows income
    // because it is the sum of income sources. Period close/reopen, strategy
    // and configuration keys are absent from the whitelist on purpose: they
    // remain owner/editor operations. The permission map and change set are
    // each bound once (`let`) to stay far below the 1000-expression cap.
    function customMonthChangesGranted(p) {
      let changed = incoming().diff(existing()).affectedKeys();
      // Each grant is read ONCE into a name. `p.get(area, 'none')` appearing
      // twice in the expression below is two map lookups against the same
      // budget, and this function is charged to the tightest rule in the file.
      let balances = p.get('balances', 'none');
      let income = p.get('income', 'none');
      let expenses = p.get('expenses', 'none');
      let fixedBills = p.get('fixedBills', 'none');
      let savings = p.get('savings', 'none');
      let debts = p.get('debts', 'none');
      return changed.hasOnly([
          'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'updatedByUserId',
          'bankPart', 'homePart', 'walletPart', 'placeBalances',
          'totalBudget', 'transfers', 'balanceAdjustments',
          'incomeSources',
          'variableExpenses', 'variableCategoryBases', 'categoryBudgets', 'rolloverFromPrevious',
          'fixedExpenses', 'fixedCategoryBases',
          'activeCategories', 'categoryColors', 'categoryIcons', 'categoryEnvelopes',
          'savingsActivity', 'monthlySavingsTarget',
          'debts'
        ])
        && (balances == 'editAll'
          || !changed.hasAny(['transfers', 'balanceAdjustments']))
        && (balances == 'editAll' || income == 'editAll'
          || !changed.hasAny(['totalBudget']))
        && (income == 'editAll' || !changed.hasAny(['incomeSources']))
        && (expenses == 'editAll'
          || !changed.hasAny(['variableExpenses', 'variableCategoryBases', 'categoryBudgets', 'rolloverFromPrevious']))
        && (fixedBills == 'editAll'
          || !changed.hasAny(['fixedExpenses', 'fixedCategoryBases']))
        && (expenses == 'editAll' || fixedBills == 'editAll'
          || !changed.hasAny(['activeCategories', 'categoryColors', 'categoryIcons', 'categoryEnvelopes']))
        && (savings == 'editAll'
          || !changed.hasAny(['savingsActivity', 'monthlySavingsTarget']))
        && (debts == 'editAll' || !changed.hasAny(['debts']));
    }

    // Field-level shape checks, tolerating keys an older document never had:
    // `households/{hid}` is validated in full on create and per-patch on update.
    function validHouseholdConfigFields(data) {
      return (!('currency' in data)
        || (data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8))
        && (!('moneyPlaces' in data)
          || (data.moneyPlaces is list && data.moneyPlaces.size() > 0 && data.moneyPlaces.size() <= 30))
        && (!('activeCategories' in data)
          || (data.activeCategories is list && data.activeCategories.size() <= 100))
        && (!('monthStartDate' in data)
          || (data.monthStartDate is int && data.monthStartDate >= 1 && data.monthStartDate <= 31))
        && (!('entitlementSource' in data)
          || tokenValue(data.entitlementSource) in ['launch_trial', 'stripe', 'cmi', 'admin'])
        && (!('entitlementStatus' in data)
          || tokenValue(data.entitlementStatus)
            in ['trialing', 'active', 'grace_period', 'past_due', 'canceled', 'expired'])
        // Milliseconds since the epoch; `is number` (not `is int`) because a
        // hand-edited document can hold the same instant as a double, and an
        // aborted comparison would deny every later write to the household.
        && (!('entitlementEndsAtMs' in data)
          || (data.entitlementEndsAtMs is number && data.entitlementEndsAtMs > 0));
    }
    function validHouseholdConfig(data) {
      return validHouseholdConfigFields(data)
        && 'currency' in data
        && 'moneyPlaces' in data
        && 'activeCategories' in data;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && incoming().plan == 'free'
        && !incoming().keys().hasAny([
          'entitlementSource', 'entitlementStatus', 'entitlementStartedAtMs',
          'entitlementEndsAtMs', 'proTrialClaimedAt',
          'planBillingCycle', 'planNextBillingDate'
        ])
        && incoming().currency is string
        && incoming().onboardingComplete is bool;
      allow update: if owner(uid)
        && (!entitlementFieldsChanged() || validLaunchTrialClaim())
        && (!('currency' in incoming()) || incoming().currency is string)
        && (!('onboardingComplete' in incoming()) || incoming().onboardingComplete is bool)
        && (!('displayName' in incoming()) || incoming().displayName == null
          || (incoming().displayName is string && incoming().displayName.size() <= 120))
        && (!('activeWorkspace' in incoming()) || incoming().activeWorkspace in ['personal', 'household'])
        && (!('householdIds' in incoming())
          || (incoming().householdIds is list && incoming().householdIds.size() <= 50));
      allow delete: if owner(uid);

      match /months/{key} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && isValidMonthId(key)
          && validMonthDocument()
          && !periodClosed(incoming())
          && incoming().revision == 1
          && existsAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId));
        allow update: if owner(uid)
          && isValidMonthId(key)
          && validMonthDocument()
          && validPeriodStateTransition()
          && ((!('revision' in existing()) && incoming().revision == 1)
            || ('revision' in existing()
              && existing().revision is int
              && incoming().revision == existing().revision + 1))
          && existsAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId)).data.get('kind', '') != 'bootstrap'
          && ((!periodClosed(existing()) && !periodClosed(incoming()))
            || (!periodClosed(existing()) && periodClosed(incoming())
              && getAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId)).data.get('kind', '') == 'month-close')
            || (periodClosed(existing()) && !periodClosed(incoming())
              && getAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId)).data.get('kind', '') == 'month-reopen'));
        allow delete: if owner(uid);
      }

      match /data/savings {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && incoming().revision == 1
          && incoming().lastMutationId is string
          && incoming().lastMutationId.size() > 0
          && incoming().lastMutationId.size() <= 160
          && existsAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId))
          && (!('goals' in incoming()) || (incoming().goals is list && incoming().goals.size() <= 200));
        allow update: if owner(uid)
          && ((!('revision' in existing()) && incoming().revision == 1)
            || ('revision' in existing()
              && existing().revision is int
              && incoming().revision == existing().revision + 1))
          && incoming().lastMutationId is string
          && incoming().lastMutationId.size() > 0
          && incoming().lastMutationId.size() <= 160
          && existsAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/ledger/$(incoming().lastMutationId)).data.get('kind', '') != 'savings-bootstrap'
          && (!('goals' in incoming()) || (incoming().goals is list && incoming().goals.size() <= 200));
        allow delete: if owner(uid);
      }

      match /ledger/{mutationId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid)
          && ledgerRowAgrees(uid, mutationId, 'personal')
          && ((incoming().get('monthKey', '') == 'savings'
              && existsAfter(/databases/$(database)/documents/users/$(uid)/data/savings)
              && getAfter(/databases/$(database)/documents/users/$(uid)/data/savings).data.get('lastMutationId', '') == mutationId)
            || (isValidMonthId(incoming().get('monthKey', ''))
              && existsAfter(/databases/$(database)/documents/users/$(uid)/months/$(incoming().get('monthKey', '')))
              && getAfter(/databases/$(database)/documents/users/$(uid)/months/$(incoming().get('monthKey', ''))).data.get('lastMutationId', '') == mutationId));
        allow update: if false;
        // Audit records remain immutable while their financial record exists,
        // but can still be erased after an account/budget teardown.
        allow delete: if owner(uid)
          && ((existing().get('monthKey', '') == 'savings'
              && !existsAfter(/databases/$(database)/documents/users/$(uid)/data/savings))
            || (isValidMonthId(existing().get('monthKey', ''))
              && !existsAfter(/databases/$(database)/documents/users/$(uid)/months/$(existing().get('monthKey', '')))));
      }

      match /products/{barcode} {
        allow get, list: if owner(uid);
        allow create: if owner(uid)
          && (barcode.matches('^[0-9]{8}$') || barcode.matches('^[0-9]{13}$'))
          && boundedText(incoming().name, 100)
          && (!('lastPrice' in incoming()) || isMoney(incoming().lastPrice));
        allow update: if owner(uid)
          && (!('lastPrice' in incoming()) || isMoney(incoming().lastPrice))
          && (!('name' in incoming()) || boundedText(incoming().name, 100));
        allow delete: if owner(uid);
      }

      match /sessions/{sessionId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid)
          && incoming().status in ['active', 'completed']
          && incoming().place is string
          && incoming().place.size() > 0
          && incoming().place.size() <= 80
          && isMoney(incoming().total)
          && incoming().items is list
          && incoming().items.size() <= 500;
        allow update: if owner(uid)
          && isMoney(incoming().total)
          && incoming().items is list
          && incoming().items.size() <= 500
          && (!('status' in incoming()) || incoming().status in ['active', 'completed']);
        allow delete: if owner(uid);
      }
    }

    // Joining or rejoining by invitation has to prove the invitation was addressed to this
    // account, was still pending and unexpired, and is accepted by the same batch. It is
    // one function because the two member rules each expanded the same nine paths: a
    // request that outgrows the expression budget is answered with a plain denial rather
    // than an error, which is the failure mode this file keeps having to remove.
    function invitationJoinOk(hid) {
      let after = incoming();
      let inviteId = after.get('inviteId', '');
      let invitePath = /databases/$(database)/documents/householdInvites/$(inviteId);
      let offered = inviteId is string && inviteId != '' && exists(invitePath)
        ? get(invitePath).data : {};
      let result = inviteId is string && inviteId != '' && existsAfter(invitePath)
        ? getAfter(invitePath).data : {};
      // A custom member may only join with exactly the grants the owner put on the
      // invitation - never a self-authored variation.
      return emailMatches(after.get('email', ''))
        && offered.get('householdId', '') == hid
        && offered.get('status', '') == 'pending'
        && emailMatches(offered.get('email', ''))
        && offered.get('role', '') == after.get('role', '')
        && after.get('permissions', {}) == offered.get('permissions', {})
        && offered.get('expiresAtMs', 0) > request.time.toMillis()
        && result.get('status', '') == 'accepted'
        && result.get('acceptedByUserId', '') == request.auth.uid;
    }

    /*
     * Membership creation, deliberately split into THREE `allow create`
     * statements rather than one function with three OR-ed branches.
     *
     * Rules inline every function call into the caller's expression budget, and
     * a request may evaluate at most 1000 expressions. Folded together these
     * branches cost ~1088 - over the cap - so the engine refused the write
     * outright with a bare `permission-denied`, before any branch was even
     * consulted. That broke HOUSEHOLD CREATION for a perfectly entitled owner:
     * the batch writes the household root and the owner's own membership row,
     * and the member write was rejected for arithmetic reasons rather than
     * authorization ones. Firestore evaluates each `allow` of the same method
     * independently and ORs the results, so splitting them keeps the exact same
     * authorization surface while giving each branch its own budget.
     *
     * Each branch below reads only what it needs: the founding owner needs the
     * household root only, and must NOT pay for the invitation machinery.
     */

    /** The household owner writing their own `owner` row (household creation). */
    function memberCreateSelfOwner(hid, memberId) {
      let after = incoming();
      return memberId == request.auth.uid
        && householdOwner(hid)
        && after.get('userId', '') == request.auth.uid
        && after.get('role', '') == 'owner'
        && after.get('status', '') == 'active';
    }

    /** The owner adding somebody else (an invited row or a local profile). */
    function memberCreateByOwner(hid, memberId) {
      let after = incoming();
      let facts = householdRootFacts(hid);
      return memberId != request.auth.uid
        && facts.owner && facts.paid
        && after.get('role', '') in ['editor', 'viewer', 'contributor', 'custom', 'profile']
        && memberDocPermissionsValid()
        && after.get('status', '') in ['invited', 'active'];
    }

    /** A recipient claiming their own row, proven by the invitation itself. */
    function memberCreateByInvitee(hid, memberId) {
      let after = incoming();
      return memberId == request.auth.uid
        && verifiedEmail()
        && householdEntitled(hid)
        && after.get('userId', '') == request.auth.uid
        && after.get('status', '') == 'active'
        && after.get('role', '') in ['editor', 'viewer', 'contributor', 'custom']
        && memberDocPermissionsValid()
        && invitationJoinOk(hid);
    }

    /*
     * Membership updates, split for the same reason as the create rules above:
     * folded into one expression the four branches cost ~1283, over the
     * 1000-expression cap, so the engine refused every membership edit -
     * including a member retiring their own row - with a bare
     * `permission-denied`. Split, each branch is comfortably within budget and
     * the authorization surface is byte-for-byte the same.
     */

    /** The owner re-roling somebody who is not an owner. */
    function memberUpdateByOwner(hid) {
      let after = incoming();
      let before = existing();
      let facts = householdRootFacts(hid);
      return facts.owner && facts.paid
        && before.get('role', '') != 'owner'
        && after.get('role', '') in ['editor', 'viewer', 'contributor', 'custom', 'profile']
        && (after.get('role', '') != 'custom' || memberDocPermissionsValid())
        && (!('userId' in before) || after.get('userId', '') == before.userId);
    }

    /** The recipient retiring the email-bound pending row that names them. */
    function memberUpdateRetireInvited() {
      let after = incoming();
      let before = existing();
      return verifiedEmail()
        && emailMatches(before.get('email', ''))
        && before.get('status', '') == 'invited'
        && after.get('status', '') == 'inactive'
        && after.get('userId', '') == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['status', 'userId', 'retiredAt', 'joinedAt']);
    }

    /** Any member deactivating their own row (leaving the household). */
    function memberUpdateLeave(memberId) {
      let after = incoming();
      let before = existing();
      return memberId == request.auth.uid
        && before.get('userId', memberId) == request.auth.uid
        && after.get('status', '') == 'inactive'
        && after.diff(before).affectedKeys().hasOnly(['status', 'retiredAt']);
    }

    /**
     * Returning member: an inactive row is reactivated only through the same
     * atomic invitation proof the fresh-create branch demands.
     */
    function memberUpdateRejoin(hid, memberId) {
      let after = incoming();
      let before = existing();
      return memberId == request.auth.uid
        && verifiedEmail()
        && householdEntitled(hid)
        && before.get('userId', memberId) == request.auth.uid
        && before.get('status', '') == 'inactive'
        && after.get('userId', '') == request.auth.uid
        && after.get('status', '') == 'active'
        && after.get('role', '') in ['editor', 'viewer', 'contributor', 'custom']
        && memberDocPermissionsValid()
        && invitationJoinOk(hid);
    }

    // The household's own settings write, with the pre- and post-state named once: this
    // is the single most frequently evaluated rule in the file, and it used to expand
    // `existing()` four times and `incoming()` five. `householdOwner(hid)` is gone
    // because for an update of this very document the stored owner is `before`, which
    // keeps the same guarantee - a household that never stored `ownerId` cannot be
    // claimed, and can still be repaired, because the create rule pins it to the writer.
    /*
     * Household settings writes, split into two `allow update` statements.
     *
     * Folded together these cost ~1061 against the 1000-expression cap, so an
     * over-budget request was refused before either branch ran - and the
     * "Restore shared access" repair the UI points a locked-out owner at is
     * precisely the second branch. The repair could never succeed, which is why
     * the workspace card kept recommending it after it had already been tried.
     *
     * `householdOwner(hid)` is deliberately absent from both: for an update of
     * this very document the stored owner is `before`, which keeps the same
     * guarantee (a household that never stored `ownerId` cannot be claimed, and
     * can still be repaired, because the create rule pins it to the writer)
     * without a second read of the root.
     */

    /** Shared preconditions: the caller owns it and the patch is well shaped. */
    function householdUpdateShapeOk() {
      let after = incoming();
      let before = existing();
      return before.get('ownerId', '') == request.auth.uid
        && validHouseholdConfigFields(after)
        && after.get('createdAt', '') == before.get('createdAt', '');
    }

    /**
     * Ordinary configuration write: identity and entitlement fields are frozen,
     * and the workspace must currently hold an entitlement.
     */
    function householdConfigUpdateOk() {
      return householdUpdateShapeOk()
        && householdEntitledFor(existing())
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'entitlementOwnerId', 'planOwnerId',
          'entitlementSource', 'entitlementStatus', 'entitlementEndsAtMs'
        ]);
    }

    /** The one repair that must stay possible while the workspace has no plan. */
    function householdSponsorRepairOk() {
      return householdUpdateShapeOk()
        && householdSponsorBindingValid(incoming(), request.auth.uid);
    }

    match /households/{hid} {
      allow get: if householdMember(hid) || householdOwner(hid);
      allow create: if signedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().planOwnerId == request.auth.uid
        && incoming().entitlementOwnerId == request.auth.uid
        && boundedText(incoming().name, 100)
        && validHouseholdConfig(incoming())
        && validHouseholdEntitlementProjection(incoming(), request.auth.uid);
      // Two statements; Firestore ORs the matching ones. The ordinary write is
      // offered first because it is by far the more common.
      allow update: if householdConfigUpdateOk();
      allow update: if householdSponsorRepairOk();
      allow delete: if householdOwner(hid);

      match /members/{memberId} {
        allow get: if householdFinanceReader(hid)
          || householdOwner(hid)
          || (verifiedEmail() && (memberId == request.auth.uid || emailMatches(resource.data.get('email', ''))));
        allow list: if householdFinanceReader(hid) || householdOwner(hid);

        // Three statements, one per legitimate origin of a membership row.
        // Firestore ORs the `allow create` rules that match, so this is exactly
        // the previous condition - but each branch gets its own expression
        // budget instead of sharing one that the sum had already overrun.
        allow create: if memberCreateSelfOwner(hid, memberId);
        allow create: if memberCreateByOwner(hid, memberId);
        allow create: if memberCreateByInvitee(hid, memberId);

        // Split per origin; Firestore ORs matching `allow update` statements.
        allow update: if memberUpdateByOwner(hid);
        allow update: if memberUpdateRetireInvited();
        allow update: if memberUpdateLeave(memberId);
        allow update: if memberUpdateRejoin(hid, memberId);
        // An owner row is protected from everyone - including another owner -
        // EXCEPT its own holder. Tearing down a workspace has to remove the
        // founder's row, and `role != 'owner'` refused exactly that, so the
        // delete always failed on the last member and the household could
        // never be removed. Self-deletion is safe to allow: `householdEditor`
        // falls back to `householdOwner`, which reads `ownerId` off the root
        // rather than the membership row, and `memberCreateSelfOwner` lets an
        // owner write their own row back - so this can strand nobody.
        allow delete: if householdOwner(hid)
          && (resource.data.get('role', '') != 'owner' || memberId == request.auth.uid);
      }

      match /invoices/{invoiceId} {
        allow get: if householdEditor(hid)
          || (customMember(hid) && customLevel(hid, 'invoices') == 'view')
          || (householdMember(hid) && resource.data.get('submitterId', '') == request.auth.uid);
        allow list: if householdEditor(hid)
          || (customMember(hid) && customLevel(hid, 'invoices') == 'view')
          || (householdMember(hid) && resource.data.get('submitterId', '') == request.auth.uid);
        allow create: if householdEntitled(hid)
          && householdMember(hid)
          && (memberRole(hid) in ['owner', 'editor', 'contributor']
            || (memberRole(hid) == 'custom' && customLevel(hid, 'invoices') == 'editOwn'))
          && incoming().id == invoiceId
          && incoming().submitterId == request.auth.uid
          && incoming().status == 'submitted'
          && boundedText(incoming().name, 100)
          && isPositiveMoney(incoming().amount)
          && incoming().date is string
          && incoming().place is string
          && incoming().place.size() > 0
          && incoming().place.size() <= 80
          && (!('receiptUrl' in incoming())
            || (incoming().receiptUrl is string && incoming().receiptUrl.size() <= 120000));
        allow update: if householdWriter(hid)
          && existing().get('status', '') == 'submitted'
          && incoming().status in ['approved', 'rejected']
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'reviewedAt', 'reviewedByUserId', 'postedExpenseId', 'postedMonthKey'
          ])
          && incoming().reviewedByUserId == request.auth.uid
          && (incoming().status == 'rejected'
            || (incoming().postedExpenseId == 'invoice-' + invoiceId
              && invoicePostedMonthOk(hid, invoiceId)));
        allow delete: if householdOwner(hid)
          || (householdMember(hid)
            && existing().get('submitterId', '') == request.auth.uid
            && existing().get('status', '') == 'submitted');
      }

      match /months/{key} {
        allow read: if householdFinanceReader(hid) || householdOwner(hid) || customFinanceViewer(hid);
        // A custom month writer may create (bootstrap) a missing month
        // document: a valid month document structurally carries every area's
        // keys, so creation cannot be split per grant. Ongoing edits are the
        // enforced surface - see the update rule.
        // The finance-writer branch decides the closed case itself (owner only);
        // `validMonthDocument()` still demands `closedAt`/`closedByUserId` of it.
        allow create: if monthCreateByFinanceWriter(hid)
          && isValidMonthId(key)
          && validMonthDocument()
          && incoming().revision == 1
          && mutationLedger(hid).present;
        allow create: if monthCreateByCustomMember(hid)
          && isValidMonthId(key)
          && validMonthDocument()
          && !periodClosed(incoming())
          && incoming().revision == 1
          && mutationLedger(hid).present;
        // Split by writer kind AND by what the write does. Firestore ORs the
        // matching `allow update` statements, so this is the same authorization
        // surface - but the common edit no longer pays for the close/reopen
        // machinery, nor the owner path for the custom member's per-area diff.
        allow update: if monthOrdinaryUpdateByFinanceWriter(hid)
          && isValidMonthId(key) && validMonthDocument();
        allow update: if monthUpdateByCustomMember(hid)
          && isValidMonthId(key) && validMonthDocument();
        // Close/reopen may only move period-state keys, so the money-shape
        // checks in `validMonthDocument()` cannot be violated by it and are not
        // charged to this branch's budget.
        // PROBE (revert after diagnosis): disable the close branch to test whether
        // the request budget is shared across `allow` statements. If the import
        // test goes green with this off, the budget is per-request, not
        // per-statement, and the split must be undone.
        allow update: if false
          && isValidMonthId(key) && validMonthPeriodFields();
        allow delete: if householdOwner(hid);
      }

      match /data/savings {
        allow read: if householdFinanceReader(hid)
          || householdOwner(hid)
          || (customMember(hid) && customLevel(hid, 'savings') != 'none');
        allow create: if householdSavingsGate(hid)
          && incoming().revision == 1
          && savingsMutationAgrees(hid, true)
          && (!('goals' in incoming()) || (incoming().goals is list && incoming().goals.size() <= 200));
        // `lastMutationId` is bounded by `mutationLedger()`, which has to read the
        // row anyway; a key too long to have been accepted by the ledger rules can
        // never name a row, so it is refused there rather than here.
        allow update: if householdSavingsGate(hid)
          && validRevisionBump()
          && savingsMutationAgrees(hid, false)
          && (!('goals' in incoming()) || (incoming().goals is list && incoming().goals.size() <= 200));
        allow delete: if householdOwner(hid);
      }

      match /ledger/{mutationId} {
        allow get, list: if householdFinanceReader(hid) || householdOwner(hid) || customFinanceViewer(hid);
        // Custom writers record ordinary finance mutations; closing/reopening
        // a period and approving invoices remain owner/editor ledger kinds.
        // The month/savings documents named by the mutation enforce the
        // per-area grants - the ledger row is bookkeeping for sync.
        allow create: if householdLedgerGate(hid)
          && ledgerRowAgrees(hid, mutationId, 'household')
          && mutationTargetAgrees(hid, mutationId);
        allow update: if false;
        allow delete: if householdOwner(hid)
          && ((existing().get('monthKey', '') == 'savings'
              && !existsAfter(/databases/$(database)/documents/households/$(hid)/data/savings))
            || (isValidMonthId(existing().get('monthKey', ''))
              && !existsAfter(/databases/$(database)/documents/households/$(hid)/months/$(existing().get('monthKey', '')))));
      }
    }

    match /householdInvites/{inviteId} {
      allow get: if verifiedEmail()
        && (emailMatches(resource.data.get('email', ''))
          || householdOwner(resource.data.get('householdId', '')));
      allow list: if signedIn()
        && (resource.data.get('createdBy', '') == request.auth.uid
          || (verifiedEmail() && emailMatches(resource.data.get('email', ''))));
      allow create: if signedIn()
        && householdOwner(incoming().householdId)
        && householdEntitled(incoming().householdId)
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending'
        && incoming().role in ['editor', 'viewer', 'contributor', 'custom']
        && (incoming().role != 'custom' || validCustomPermissions(incoming().get('permissions', {})))
        && isEmail(incoming().email)
        && incoming().expiresAtMs is number
        && incoming().expiresAtMs > request.time.toMillis()
        && incoming().expiresAtMs <= request.time.toMillis() + 1296000000;
      allow update: if (householdOwner(existing().get('householdId', ''))
          && incoming().get('status', '') == 'revoked'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'revokedAt']))
        || (verifiedEmail()
          // An invitation that never stored its household cannot be claimed either, and the
          // empty id is checked before it reaches a path: a malformed path aborts the rule,
          // which is the failure this pass exists to remove.
          && existing().get('householdId', '') != ''
          && emailMatches(existing().get('email', ''))
          && existing().get('status', '') == 'pending'
          && existing().get('expiresAtMs', 0) > request.time.toMillis()
          && incoming().get('status', '') == 'accepted'
          && incoming().get('acceptedByUserId', '') == request.auth.uid
          && emailMatches(incoming().get('acceptedEmail', ''))
          && existsAfter(/databases/$(database)/documents/households/$(existing().get('householdId', ''))/members/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/households/$(existing().get('householdId', ''))/members/$(request.auth.uid)).data.get('inviteId', '') == inviteId
          && getAfter(/databases/$(database)/documents/households/$(existing().get('householdId', ''))/members/$(request.auth.uid)).data.get('role', '') == existing().get('role', '')
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'acceptedAt', 'acceptedByUserId', 'acceptedEmail'
          ]))
        || (verifiedEmail()
          // An invitation that never stored its household cannot be claimed either, and the
          // empty id is checked before it reaches a path: a malformed path aborts the rule,
          // which is the failure this pass exists to remove.
          && existing().get('householdId', '') != ''
          && emailMatches(existing().get('email', ''))
          && existing().get('status', '') == 'pending'
          && incoming().get('status', '') == 'revoked'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'revokedAt']));
      allow delete: if householdOwner(existing().get('householdId', ''));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
